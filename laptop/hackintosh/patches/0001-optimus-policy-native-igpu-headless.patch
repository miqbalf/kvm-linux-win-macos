diff --git a/plugin/nvmtl_gpu_policy.h b/plugin/nvmtl_gpu_policy.h
index 9c52607..fa9d29a 100644
--- a/plugin/nvmtl_gpu_policy.h
+++ b/plugin/nvmtl_gpu_policy.h
@@ -8,11 +8,12 @@
  * Which processes get the NVIDIA GPU as a Metal device on a hybrid laptop. Plain C so tools/test_gpu_policy.c runs the same
  * code on the host; NVMTLDevice.m supplies the inputs.
  *
- * Only active when the hybrid switch (boot-arg nmhybrid) is on, and only matters when another GPU also offers Metal
- * (an integrated GPU macOS still drives, such as Coffee Lake). With no second Metal GPU the NVIDIA device is the only
- * choice and is always given.
+ * Active when the hybrid switch (boot-arg nmhybrid) is on OR when native integrated graphics drive the display and the
+ * NVIDIA GPU runs in headless offload mode (debug.nvaccel_headless == 1). With no second Metal GPU the NVIDIA device
+ * is the only choice and is always given.
  *
  * Policy file /Library/GPUBundles/nvmtl-gpu-policy.txt, one rule per line, '#' starts a comment:
+ *     mode igpu            only processes with an explicit 'nvidia' line get the NVIDIA device
  *     mode nvidia          (default) every process gets the NVIDIA device
  *     mode apple           follow Apple's rule: a process whose Info.plist sets NSSupportsAutomaticGraphicsSwitching to
  *                          true is content with the low-power GPU and does not get the NVIDIA device; every other process
@@ -28,6 +29,7 @@
 #include <string.h>
 
 enum { NMP_PREF_AUTO = 0, NMP_PREF_NVIDIA = 1, NMP_PREF_IGPU = 2 };
+enum { NMP_MODE_NVIDIA = 0, NMP_MODE_APPLE = 1, NMP_MODE_IGPU = 2 };
 
 /* Reads the policy text. Returns the per-process preference; *mode_apple is 1 for "mode apple". */
 static inline int nmp_parse(const char *text, const char *proc, int *mode_apple)
@@ -45,7 +47,10 @@ static inline int nmp_parse(const char *text, const char *proc, int *mode_apple)
         if (!*q || *q == '#') continue;
         if (!strncmp(q, "mode ", 5)) {
             char *v = q + 5; while (*v == ' ' || *v == '\t') v++;
-            if (!strcmp(v, "apple")) *mode_apple = 1; else if (!strcmp(v, "nvidia")) *mode_apple = 0;
+            size_t ml = strlen(v); while (ml && (v[ml - 1] == ' ' || v[ml - 1] == '\t')) v[--ml] = 0;
+            if (!strcmp(v, "apple")) *mode_apple = NMP_MODE_APPLE;
+            else if (!strcmp(v, "nvidia")) *mode_apple = NMP_MODE_NVIDIA;
+            else if (!strcmp(v, "igpu")) *mode_apple = NMP_MODE_IGPU;
         } else if (!strncmp(q, "igpu ", 5) || !strncmp(q, "nvidia ", 7)) {
             int ig = q[0] == 'i';
             char *v = q + (ig ? 5 : 7); while (*v == ' ' || *v == '\t') v++;
@@ -56,6 +61,40 @@ static inline int nmp_parse(const char *text, const char *proc, int *mode_apple)
     return pref;
 }
 
+/* Effective hybrid level: explicit nmhybrid (>0), or 1 when native integrated graphics own the display and NVIDIA runs headless. */
+static inline int nmp_hybrid_active(int nmhybrid, int nvaccel_headless)
+{
+    if (nmhybrid > 0) return nmhybrid;
+    return nvaccel_headless > 0 ? 1 : 0;
+}
+
+/* Also honor explicit root-owned policy file when booted with HDMI connected on dual-GPU laptops (debug.nvaccel_headless == 0). */
+static inline int nmp_hybrid_active_for_policy(int nmhybrid, int nvaccel_headless, int has_policy_file)
+{
+    int base = nmp_hybrid_active(nmhybrid, nvaccel_headless);
+    if (base > 0) return base;
+    return has_policy_file > 0 ? 1 : 0;
+}
+
+/* 1 = block WindowServer from NVIDIA Metal when non-NVIDIA or purely headless (debug.nvaccelfb == 0);
+   0 = allow WindowServer once an NVIDIA display framebuffer is armed (including post-boot HDMI hotplug). */
+static inline int nmp_windowserver_headless_block(int vk_vendor_is_nv, int nvaccel_armed, int nvaccel_headless)
+{
+    if (!vk_vendor_is_nv) return 1;
+    if (nvaccel_armed) return 0;
+    return nvaccel_headless ? 1 : 0;
+}
+
+/* 1 = private copy-out per process; 0 = allow shared family VRAM (item 7).
+   WindowServer driving an armed NVIDIA framebuffer needs shared VRAM ONLY when zero-copy flip is active;
+   when iop_flip_on == 0 (copy path), keep WindowServer on system-memory copy-out to avoid exhausting 256 MB BAR1. */
+static inline int nmp_gpu_headless(int vk_vendor_is_nv, int is_windowserver, int nvaccel_armed, int iop_flip_on, int nvaccel_headless)
+{
+    if (!vk_vendor_is_nv) return 1;
+    if (is_windowserver && nvaccel_armed && iop_flip_on) return 0;
+    return nvaccel_headless ? 1 : 0;
+}
+
 /* 1 = give the process the NVIDIA device. app_auto_switch: the Info.plist value, -1 when absent. */
 static inline int nmp_decide(int hybrid_level, int mode_apple, int pref, int app_auto_switch, int other_metal_gpu, const char **why)
 {
@@ -65,9 +104,10 @@ static inline int nmp_decide(int hybrid_level, int mode_apple, int pref, int app
     else if (!other_metal_gpu)          { w = "no other Metal GPU to use instead"; r = 1; }
     else if (pref == NMP_PREF_IGPU)     { w = "policy: this process uses the integrated GPU"; r = 0; }
     else if (pref == NMP_PREF_NVIDIA)   { w = "policy: this process uses the NVIDIA GPU"; r = 1; }
-    else if (!mode_apple)               { w = "mode nvidia"; r = 1; }
-    else if (app_auto_switch == 1)      { w = "mode apple: the app allows automatic graphics switching"; r = 0; }
-    else                                { w = "mode apple: the app does not opt into automatic switching"; r = 1; }
+    else if (mode_apple == NMP_MODE_IGPU)   { w = "mode igpu: using the integrated GPU"; r = 0; }
+    else if (mode_apple == NMP_MODE_NVIDIA) { w = "mode nvidia"; r = 1; }
+    else if (app_auto_switch == 1)          { w = "mode apple: the app allows automatic graphics switching"; r = 0; }
+    else                                    { w = "mode apple: the app does not opt into automatic switching"; r = 1; }
     if (why) *why = w;
     return r;
 }
