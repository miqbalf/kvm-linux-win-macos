    # ---------- state ----------
    def poll(self):
        def work():
            s = read_state()
            GLib.idle_add(self.render, s)
        threading.Thread(target=work, daemon=True).start()
        return True

    def render(self, s):
        self.state = s
        run = s["running"]
        win_gpu, win_virt, mac_on = "win10-gpu" in run, "win10" in run, "macos-igpu" in run
        win_any = win_gpu or win_virt
        busy = s["busy"]
        df = s.get("deskflow", {})
        no_lg = s.get("no_lg", False)

        self._no_lg_syncing = True
        if self.no_lg_switch.get_active() != no_lg:
            self.no_lg_switch.set_active(no_lg)
        self._no_lg_syncing = False

        hdmi = s.get("hdmi", {})
        hdmi_locked = hdmi.get("locked", True)
        hdmi_live = (not hdmi_locked and not hdmi.get("tags_ignored") and not hdmi.get("gs_mesa")
                     and s.get("gtx") == "nvidia" and (hdmi.get("gs_open") or bool(hdmi.get("card"))))

        # hero
        if mac_on:
            icon, title, sub = "video-display-symbolic", "macOS has the laptop screen", "Apple menu > Shut Down to come back."
        elif win_gpu:
            icon, title = "input-gaming-symbolic", "Linux + Windows (GTX 1650 passthrough)"
            sub = ("Windows drives the HDMI port directly"
                   + (" · mouse shares via Deskflow." if df.get("mode") == "local" else " · Right Ctrl grabs/releases Looking Glass."))
        elif win_virt:
            icon = "video-joined-displays-symbolic" if hdmi_live else "computer-symbolic"
            title = "Linux + Windows (Virtual GPU)" + (" · External HDMI" if hdmi_live else "")
            sub = "Linux keeps all screens; open the resizable Windows desktop or individual Windows apps side-by-side."
        elif hdmi_live:
            icon, title = "video-joined-displays-symbolic", "Linux (External HDMI enabled)"
            sub = "Linux drives laptop + HDMI. Start Windows (Virtual GPU) below to run Windows across both screens."
        else:
            icon, title, sub = "computer-symbolic", "Linux", "No virtual machine is running. GTX 1650 and laptop screen belong to Linux."
        if busy:
            title, sub = "Switching…", "A GPU is moving between Linux and a VM. This takes up to a minute."
        self.hero_icon.set_from_icon_name(icon)
        self.hero_title.set_label(title)
        self.hero_sub.set_label(sub)

        # Windows card (unified Virtual GPU + GTX 1650 Passthrough)
        wp = self.pending.get("win10-gpu") or self.pending.get("win10")
        if busy or wp:
            self.win.set_state(wp or "Switching", "busy", "Please wait…")
            self.win.set_buttons([("Working…", None, None)])
        elif win_gpu:
            desc = ("On the GTX 1650 + physical HDMI."
                    + (" Mouse glides via Deskflow." if df.get("mode") == "local" else "")
                    + ("" if s["lg"] else " Looking Glass window is hidden."))
            self.win.set_state("Running · GTX 1650", "on", desc)
            self.win.set_buttons([
                ("Looking Glass open" if s["lg"] else "Open Looking Glass", "suggested-action", None if s["lg"] else self.win_show),
                ("Windows apps", None, self.show_apps),
                ("Linux terminal", None, self.win_terminal),
                ("Shut down", None, self.win_stop),
            ])
        elif win_virt:
            desc = ("Virtual GPU — Linux keeps eDP-1 and HDMI."
                    + (" Full desktop window is open." if s["rdp_desktop"] else " Open desktop or Coherence app windows."))
            self.win.set_state("Running · Virtual GPU", "on", desc)
            self.win.set_buttons([
                ("Desktop is open" if s["rdp_desktop"] else "Open desktop", "suggested-action",
                 None if s["rdp_desktop"] else self.virt_show),
                ("Windows apps", None, self.show_apps),
                ("Shut down", None, self.virt_stop),
            ])
        else:
            if not hdmi_locked:
                self.win.set_state("Off", "off",
                                   "External HDMI is active on Linux, so Virtual GPU runs right across both Linux screens. "
                                   "Switch External HDMI to VM mode below to use GTX 1650 passthrough.")
                self.win.set_buttons([
                    ("Start (Virtual GPU)", "suggested-action", self.virt_start),
                    ("Start (GTX 1650)", None, None),
                ])
            else:
                self.win.set_state("Off", "off",
                                   "GTX 1650 passes through full GPU + HDMI port. "
                                   "Virtual GPU keeps GTX/HDMI on Linux and runs Windows/apps as Linux windows.")
                self.win.set_buttons([
                    ("Start (GTX 1650)", "suggested-action", self.win_start),
                    ("Start (Virtual GPU)", None, self.virt_start),
                ])

        active_win = "win10-gpu" if win_gpu else "win10" if win_virt else None
        if active_win and self.synced_vm != active_win:
            self.synced_vm = active_win
            self.sync_on_boot()
        elif not active_win:
            self.synced_vm = None

        # macOS card
        mp = self.pending.get("macos-igpu")
        if busy or mp:
            self.mac.set_state(mp or "Switching", "busy", "Please wait…")
            self.mac.set_buttons([("Working…", None, None)])
        elif mac_on:
            self.mac.set_state("Running", "on", "On the laptop screen.")
            self.mac.set_buttons([("Force back to Linux", "destructive-action", self.mac_stop)])
        else:
            why = ("Shut down Windows first." if win_any else
                   "Shut down “macOS in a window” first (same disk)." if "macos" in run else "")
            self.mac.set_state("Off", "off", why or "Full screen on the laptop panel, with graphics acceleration. "
                               "The Linux desktop closes while macOS runs.")
            self.mac.set_buttons([("Start on laptop screen", "suggested-action", None if why else self.mac_start)])

        # External HDMI card
        hp = self.pending.get("hdmi")
        conns = hdmi.get("conns", [])
        conn_on = [(n, m) for n, up, m in conns if up]
        conn_desc = ", ".join(f"{n} ({m})" if m else n for n, m in conn_on)
        if busy or hp:
            self.hdmi.set_state(hp or "Switching", "busy", "Please wait…")
            self.hdmi.set_buttons([("Working…", None, None)])
        elif mac_on:
            self.hdmi.set_state("Off", "off", "macOS has the laptop screen.")
            self.hdmi.set_buttons([("Connect external HDMI", None, None)])
        elif win_gpu:
            self.hdmi.set_state("With Windows", "off",
                                "Windows currently owns the GTX 1650 HDMI port directly. Shut down Windows (GTX) or switch to Virtual GPU to drive HDMI from Linux.")
            self.hdmi.set_buttons([("Stop Windows & connect HDMI", None, lambda: self.hdmi_enable(stop_win=True))])
        elif hdmi_live:
            self.hdmi.set_state("Active" if conn_on else "Ready", "on",
                                f"Connected: {conn_desc} — Linux drives external HDMI (compatible with Virtual GPU Windows)." if conn_on else
                                "GTX 1650 is unlocked for Linux HDMI (no monitor plugged in right now).")
            self.hdmi.set_buttons([
                ("Display settings", "suggested-action",
                 lambda: self.launch(["gnome-control-center", "display"], "GNOME Settings is not installed")),
                ("Switch to GTX passthrough mode", None, self.hdmi_disable),
            ])
        elif not hdmi_locked:
            self.hdmi.set_state("Relogin needed", "busy",
                                (f"Detected {conn_desc}. " if conn_on else "") +
                                "Restart desktop login once so GNOME opens the GTX 1650 for HDMI.")
            self.hdmi.set_buttons([
                ("Apply HDMI now", "suggested-action", lambda: self.hdmi_enable(stop_win=False)),
                ("Back to VM mode", None, self.hdmi_disable),
            ])
        else:
            self.hdmi.set_state("VM mode", "off",
                                "HDMI monitor plugged in, reserved for Windows GTX passthrough (or turn on here for Linux dual-screen + Virtual GPU)." if conn_on else
                                "HDMI port is reserved for Windows GTX passthrough.")
            self.hdmi.set_buttons([("Connect external HDMI", "suggested-action", lambda: self.hdmi_enable(stop_win=False))])

        # Deskflow / Bridge card
        dp = self.pending.get("deskflow")
        if dp:
            self.df.set_state(dp, "busy", "Updating Deskflow…")
            self.df.set_buttons([("Working…", None, None)])
        elif not df.get("installed"):
            self.df.set_state("Missing", "off", "Install deskflow and deskflow-mode to share mouse/clipboard across Linux and Windows.")
            self.df.set_buttons([])
        else:
            mode = df.get("mode", "off")
            side = df.get("side", "right")
            edge_lbl = EDGE_LABELS.get(side, "Right")
            next_side = EDGES[(EDGES.index(side) + 1) % len(EDGES)] if side in EDGES else "right"
            if mode == "local":
                self.df.set_state(f"Laptop -> Windows ({edge_lbl})", "on",
                                  f"CachyOS shares mouse, keyboard & clipboard across the {edge_lbl.lower()} edge to Windows (192.168.122.1)."
                                  + ("" if df.get("running") else " (Deskflow service paused)"))
                btns = [
                    (f"Edge: {edge_lbl}", None, lambda ns=next_side: self.df_local(ns)),
                    ("Sync Windows mouse" if win_any else "Windows off", "suggested-action" if win_any else None,
                     self.df_sync_win if win_any else None),
                    ("Linux terminal in Windows" if win_any else "Mac mode", None,
                     self.win_terminal if win_any else (self.df_mac if df.get("has_mac") else None)),
                ]
                if win_any and df.get("has_mac"):
                    btns.append(("Mac mode", None, self.df_mac))
            elif mode == "mac":
                rem = df.get("remote") or "Mac"
                self.df.set_state("Mac -> Laptop", "on",
                                  f"Following separate Mac server ({rem}). Switch to Laptop -> Windows when working standalone on CachyOS + HDMI.")
                btns = [
                    ("Use Laptop <-> Windows", "suggested-action", lambda s_=side: self.df_local(s_)),
                ]
                if win_any:
                    btns.append(("Linux terminal in Windows", None, self.win_terminal))
            else:
                self.df.set_state("Off", "off", "Enable Laptop <-> Windows so one pointer glides between laptop eDP-1 and Windows external HDMI.")
                btns = [("Use Laptop <-> Windows", "suggested-action", lambda s_=side: self.df_local(s_))]
            self.df.set_buttons(btns)

        # plain VMs in More
        for vm, (row, pill, view, act) in self.rows.items():
            on = vm in run
            p = self.pending.get(vm)
            set_pill(pill, p or ("Running" if on else "Off"), "busy" if p else "on" if on else "off")
            view.set_visible(on)
            act.set_label("Stop" if on else "Start")
            conflict = {"macos": "macos-igpu", "win10": "win10-gpu"}[vm] in run
            act.set_sensitive(not p and not busy and (on or not conflict))
            row.set_subtitle(row.get_subtitle().split(" — ")[0] + (" — VNC 127.0.0.1:%d" % VNC[vm] if on else ""))

        self.render_net(s.get("net", []))
        self.log.set_label(s["log"] or "No switches yet.")
        return False

    def render_net(self, net):
        for r in self.netrows:
            self.netgrp.remove(r)
        self.netrows = []
        if not any(n["kind"] == "internal" for n in net):
            net = [{"kind": "internal", "dev": "", "state": "with macOS" if "macos-igpu" in self.state["running"]
                    else "missing", "conn": "", "ip": ""}] + net
        if not any(n["kind"] == "dongle" for n in net):
            net = net + [{"kind": "dongle", "dev": "", "state": "not plugged in", "conn": "", "ip": ""}]
        for n in net:
            title = "Built-in Wi-Fi (Apple BCM4360)" if n["kind"] == "internal" else "USB Wi-Fi dongle"
            on = n["state"] == "connected"
            sub = (f"{n['conn']} · {n['ip']}" if on else n["state"]) + (f" · {n['dev']}" if n["dev"] else "")
            row = Adw.ActionRow(title=title, subtitle=sub)
            row.add_prefix(Gtk.Image.new_from_icon_name(
                "network-wireless-signal-excellent-symbolic" if on else "network-wireless-offline-symbolic"))
            pill = Gtk.Label(label="Online" if on else "Offline", valign=Gtk.Align.CENTER)
            pill.add_css_class("pill")
            pill.add_css_class("on" if on else "off")
            row.add_suffix(pill)
            if n["kind"] == "dongle" and n["dev"] and not on:
                b = Gtk.Button(label="Connect as backup", valign=Gtk.Align.CENTER)
                b.add_css_class("suggested-action")
                b.connect("clicked", lambda *a: self.run(["pkexec", GPU_MODE, "net-backup"], "net", "Connecting",
                                                         "Dongle connected: Linux stays online in macOS mode",
                                                         "Dongle did not connect"))
                row.add_suffix(b)
            self.netgrp.add(row)
            self.netrows.append(row)

    def dongle_online(self):
        return any(n["kind"] == "dongle" and n["state"] == "connected" for n in (self.state or {}).get("net", []))

    # ---------- actions ----------
    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=4))

    def run(self, argv, vm, label, done_msg, fail_msg, after_ok=None):
        """Run argv in the background, show `label` on vm's card meanwhile."""
        self.pending[vm] = label
        if self.state:
            self.render(self.state)

        def work():
            try:
                r = subprocess.run(argv, capture_output=True, text=True)
                rc, out = r.returncode, (r.stdout + r.stderr).strip().splitlines()
            except OSError as e:
                rc, out = 1, [str(e)]
            GLib.idle_add(finish, rc, out)

        def finish(rc, out):
            self.pending.pop(vm, None)
            if rc == 0:
                self.toast(out[-1] if done_msg is None and out else (done_msg or "Done"))
                if after_ok:
                    after_ok()
            elif argv[0] == "pkexec" and rc in (126, 127):
                self.toast("Cancelled")
            else:
                err = [l for l in out if "ERROR" in l or "error" in l or "deskflow-mode:" in l] or out
                self.fail(fail_msg, err[-1].replace("[gpu-mode] ", "") if err else "")
            self.poll()
            return False

        threading.Thread(target=work, daemon=True).start()

    def fail(self, heading, detail):
        d = Adw.AlertDialog(heading=heading, body=(detail or "No details.").replace("ERROR: ", "") +
                            "\n\nDetails: Recent activity at the bottom of this window.")
        d.add_response("ok", "OK")
        d.present(self)

    def launch(self, argv, missing):
        if not shutil.which(argv[0]):
            self.toast(missing)
            return
        subprocess.Popen(argv, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def on_no_lg_toggled(self, sw, _pspec):
        if self._no_lg_syncing:
            return
        os.makedirs(PREF_DIR, exist_ok=True)
        if sw.get_active():
            open(NO_LG_PREF, "w").write("1\n")
            self.toast("Looking Glass popup disabled on GTX start (use Open Looking Glass anytime)")
        else:
            if os.path.exists(NO_LG_PREF):
                os.remove(NO_LG_PREF)
            self.toast("Looking Glass will open when GTX Windows starts")

    def win_start(self):
        self.run(["pkexec", GPU_MODE, "win"], "win10-gpu", "Starting",
                 "Windows (GTX 1650) is starting", "Windows did not start",
                 after_ok=lambda: self.launch(["win-gpu"], "win-gpu is not installed"))

    def win_show(self):
        self.launch(["win-gpu", "desktop"], "win-gpu is not installed")
        self.toast("Opening Looking Glass. Right Ctrl grabs / releases keyboard and mouse.")

    def close_win_clients(self):
        subprocess.run(["pkill", "-u", str(os.getuid()), "-f",
                        r"looking-glass-client|xfreerdp3 .*(/app:|192\.168\.122\.13|Microsoft Windows)"])

    def win_stop(self):
        self.ask("Shut down Windows (GTX 1650)?", "Save your work in Windows first. The GTX 1650 goes back to Linux.",
                 "Shut down", Adw.ResponseAppearance.DESTRUCTIVE,
                 lambda: (self.close_win_clients(),
                          self.run(["pkexec", GPU_MODE, "win-off"], "win10-gpu", "Shutting down",
                                   "Windows is off, the GTX is back on Linux", "Shut down failed")))

    def virt_start(self):
        self.run(VIRSH + ["start", "win10"], "win10", "Starting",
                 "Windows (Virtual GPU) starting — click Open desktop or Windows apps once ready",
                 "Could not start Virtual GPU Windows")

    def virt_show(self):
        wa = shutil.which("winapps") or os.path.expanduser("~/.local/bin/winapps")
        if not os.path.exists(wa):
            self.fail("WinApps is not installed", "Run once: bash laptop/host/winapps/setup-winapps.sh <windows-user>")
            return
        subprocess.Popen(["systemd-run", "--user", "--scope", "--quiet", "--collect",
                          f"--unit=winapps-desktop-{os.getpid()}", wa, "windows"],
                         start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.toast("Opening Windows desktop (resizable across laptop & HDMI monitors)")

    def virt_stop(self):
        self.ask("Shut down Windows (Virtual GPU)?", "Open Windows desktop/app windows will close cleanly.",
                 "Shut down", Adw.ResponseAppearance.DESTRUCTIVE,
                 lambda: (self.close_win_clients(),
                          self.run(VIRSH + ["shutdown", "win10"], "win10", "Stopping",
                                   "Shutdown sent to Windows (Virtual GPU)", "Stop failed")))

    # ---------- WinApps & Deskflow background helpers ----------
    def sync_on_boot(self):
        vm = self.synced_vm
        tool = shutil.which("winapps-sync") or os.path.expanduser("~/.local/bin/winapps-sync")
        df_tool = shutil.which("deskflow-mode")
        want_df = (self.state or {}).get("deskflow", {}).get("mode") == "local"

        def work():
            for _ in range(45):
                time.sleep(2)
                r = subprocess.run(VIRSH + ["qemu-agent-command", vm, '{"execute":"guest-ping"}', "--timeout", "3"],
                                   capture_output=True)
                if r.returncode == 0:
                    break
            else:
                return
            if os.path.exists(tool):
                subprocess.run([tool, "--quiet"], capture_output=True)
            if want_df and df_tool:
                subprocess.run([df_tool, "sync-windows"], capture_output=True)

        threading.Thread(target=work, daemon=True).start()

    def show_apps(self):
        if not winapps_entries():
            self.fail("Windows apps are not set up", "Run once: bash laptop/host/winapps/setup-winapps.sh <windows-user>")
            return
        subprocess.Popen(["gdbus", "call", "--session", "--dest", "org.gnome.Shell", "--object-path", "/org/gnome/Shell",
                          "--method", "org.gnome.Shell.ShowApplications"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.toast("App grid > folder “Windows”. Each app opens in its own window.")

    def df_local(self, side):
        self.run(["deskflow-mode", "local", "--side", side], "deskflow", "Applying", None, "Deskflow switch failed")

    def df_mac(self):
        self.run(["deskflow-mode", "mac"], "deskflow", "Switching", None, "Deskflow switch failed")

    def df_sync_win(self):
        self.run(["deskflow-mode", "sync-windows"], "deskflow", "Syncing", None, "Could not sync Windows Deskflow")

    def win_terminal(self):
        self.run(["deskflow-mode", "win-terminal"], "deskflow", "Opening",
                 "Opened CachyOS terminal window on Windows", "Could not open Linux terminal in Windows")

    def mac_start(self):
        radios = self.radios.get_active()
        extra = ""
        if radios:
            extra = ("\n\nWi-Fi and Bluetooth go to macOS (experimental: the last try hung at the Apple logo). " +
                     ("Linux stays online through the USB dongle." if self.dongle_online() else
                      "The USB dongle is NOT online: Linux will have no network until macOS shuts down."))
        self.ask("Switch the laptop screen to macOS?",
                 "The Linux desktop closes and all open Linux apps end: save your work first.\n\n"
                 "macOS appears after about 1–1.5 minutes. To come back: Apple menu > Shut Down "
                 "(Linux returns by itself). If nothing responds, hold the power button." + extra,
                 "Switch to macOS", Adw.ResponseAppearance.SUGGESTED,
                 lambda: self.run(["pkexec", GPU_MODE, "mac-bg"] + (["--radios"] if radios else []), "macos-igpu",
                                  "Switching", "Switching to macOS…", "Switch failed"))

    def mac_stop(self):
        self.ask("Force back to Linux?", "macOS is powered off after 30 s. Unsaved macOS work is lost.",
                 "Force back", Adw.ResponseAppearance.DESTRUCTIVE,
                 lambda: self.run(["pkexec", GPU_MODE, "host"], "macos-igpu", "Stopping",
                                  "Back on Linux", "Failed"))

    def hdmi_enable(self, stop_win=False):
        msg = ("The Linux desktop restarts so GNOME attaches to the GTX 1650 HDMI port — "
               "open Linux apps will close, so save your work first.\n\n"
               + ("Windows will also shut down cleanly first.\n\n" if stop_win else "")
               + "Log back in and external HDMI appears in Settings → Displays.")
        def go():
            if stop_win:
                self.close_win_clients()
            self.run(["pkexec", GPU_MODE, "hdmi-on-bg"] + (["--stop-win"] if stop_win else []),
                     "hdmi", "Switching", "Restarting desktop for HDMI…", "HDMI switch failed")
        self.ask("Connect external HDMI on Linux?", msg, "Connect HDMI", Adw.ResponseAppearance.SUGGESTED, go)

    def hdmi_disable(self):
        self.ask("Switch back to GTX passthrough mode?",
                 "The Linux desktop restarts so GNOME releases the GTX 1650 — "
                 "open Linux apps will close, so save your work first.\n\n"
                 "After logging back in, external HDMI is disabled on Linux so Windows (GTX 1650) can start without logout.",
                 "Switch to VM mode", Adw.ResponseAppearance.SUGGESTED,
                 lambda: self.run(["pkexec", GPU_MODE, "hdmi-off-bg"],
                                  "hdmi", "Switching", "Restarting desktop for VM mode…", "Switch failed"))

    def toggle_plain(self, vm):
        if vm in (self.state or {}).get("running", set()):
            self.run(VIRSH + ["shutdown", vm], vm, "Stopping", f"Shutdown sent to {vm}", "Stop failed")
        else:
            self.run(VIRSH + ["start", vm], vm, "Starting", f"{vm} started, open the viewer", "Start failed")

    def open_vnc(self, vm):
        try:
            xml = subprocess.run(VIRSH + ["dumpxml", "--security-info", vm], capture_output=True, text=True).stdout
            pw = xml.split("passwd='", 1)[1].split("'", 1)[0]
            Gdk.Display.get_default().get_clipboard().set(pw)
            hint = "VNC password copied: paste it when asked"
        except (IndexError, OSError):
            hint = "Open the VNC viewer"
        viewer = next((v for v in ("gnome-connections", "remmina", "vncviewer") if shutil.which(v)), None)
        if not viewer:
            self.toast(f"No VNC viewer installed (sudo pacman -S gnome-connections). Address 127.0.0.1:{VNC[vm]}")
            return
        arg = f"127.0.0.1::{VNC[vm]}" if viewer == "vncviewer" else f"vnc://127.0.0.1:{VNC[vm]}"
        self.launch([viewer, arg], "")
        self.toast(hint)

    def ask(self, heading, body, ok_label, appearance, on_ok):
        d = Adw.AlertDialog(heading=heading, body=body)
        d.add_response("cancel", "Cancel")
        d.add_response("ok", ok_label)
        d.set_response_appearance("ok", appearance)
        d.set_default_response("cancel")
        d.connect("response", lambda _d, r: r == "ok" and on_ok())
        d.present(self)


