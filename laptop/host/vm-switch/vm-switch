# which blocks `gpu-mode win` from moving the GTX to Windows ("programs still use the GTX: python3").
os.environ["__EGL_VENDOR_LIBRARY_FILENAMES"] = "/usr/share/glvnd/egl_vendor.d/50_mesa.json"
os.environ["VK_DRIVER_FILES"] = "/usr/share/vulkan/icd.d/intel_icd.json"
