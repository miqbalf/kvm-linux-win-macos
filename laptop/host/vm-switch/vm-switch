def drv(dev):
    try:
        return os.path.basename(os.readlink(f"/sys/bus/pci/devices/{dev}/driver"))
    except OSError:
        return "none"


def switching():
    """True while gpu-mode holds its lock (a switch is in progress)."""
    try:
        with open("/run/gpu-mode.lock") as f:
            fcntl.flock(f, fcntl.LOCK_SH | fcntl.LOCK_NB)
            return False
    except BlockingIOError:
        return True
    except OSError:
        return False


def read_hdmi():
    """GTX 1650 DRM connector, passthrough locks, udev tags, and whether gnome-shell opened card0."""
    card = ""
    for p in glob.glob("/sys/class/drm/card[0-9]*/device"):
        try:
            if os.path.basename(os.path.realpath(p)) == GTX:
                card = os.path.basename(os.path.dirname(p))
                break
        except OSError:
            pass
    conns, tags_ignored = [], False
    if card:
        try:
            udev = subprocess.run(["udevadm", "info", "-q", "property", "-p", f"/sys/class/drm/{card}"],
                                  capture_output=True, text=True, timeout=3).stdout
            for line in udev.splitlines():
                if line.startswith("TAGS=") and "mutter-device-ignore" in line:
                    tags_ignored = True
        except (OSError, subprocess.TimeoutExpired):
            pass
        for c in sorted(glob.glob(f"/sys/class/drm/{card}-*")):
            try:
                st = open(f"{c}/status").read().strip() == "connected"
            except OSError:
                continue
            mode = ""
            try:
                mode = open(f"{c}/modes").readline().strip()
            except OSError:
                pass
            conns.append((os.path.basename(c).removeprefix(f"{card}-"), st, mode))
    locks = [
        "/etc/udev/rules.d/63-gtx-no-gnome.rules",
        "/etc/systemd/user/org.gnome.Shell@wayland.service.d/10-no-nvidia-egl.conf",
        "/etc/environment.d/90-gtx-free.conf",
        os.path.expanduser("~/.config/environment.d/90-gtx-free.conf"),
    ]
    locked = any(os.path.exists(f) for f in locks)
    gs_open, gs_mesa = False, False
    try:
        pids = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "gnome-shell"],
                              capture_output=True, text=True, timeout=3).stdout.split()
        if pids:
            pid = pids[0]
            for fd in glob.glob(f"/proc/{pid}/fd/*"):
                try:
                    if card and os.readlink(fd) == f"/dev/dri/{card}":
                        gs_open = True
                        break
                except OSError:
                    pass
            gs_mesa = b"__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json" in open(
                f"/proc/{pid}/environ", "rb").read()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return {"card": card, "conns": conns, "locked": locked, "tags_ignored": tags_ignored,
            "gs_open": gs_open, "gs_mesa": gs_mesa}


def read_deskflow():
    """Fast local Deskflow config & process snapshot."""
    cp = configparser.ConfigParser(interpolation=None)
    if os.path.exists(DESKFLOW_CONF):
        try:
            cp.read(DESKFLOW_CONF)
        except configparser.Error:
            pass
    cm = cp.get("core", "coreMode", fallback="0")
    mode = {"2": "local", "1": "mac"}.get(cm, "off")
    side = "right"
    try:
        s = open(DESKFLOW_SIDE_PREF).read().strip()
        if s in EDGE_LABELS:
            side = s
    except OSError:
        pass
    running = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "deskflow-core"],
                             capture_output=True).returncode == 0
    return {
        "mode": mode,
        "side": side,
        "remote": cp.get("client", "remoteHost", fallback=""),
        "running": running,
        "has_mac": os.path.exists(DESKFLOW_MAC_CONF),
        "installed": bool(shutil.which("deskflow") and shutil.which("deskflow-mode")),
    }


def pgrep_user(pattern):
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", pattern],
                          capture_output=True).returncode == 0


def read_state():
    s = {"running": set(), "igpu": drv(IGPU), "gtx": drv(GTX), "busy": switching(), "lg": False, "log": ""}
    try:
        out = subprocess.run(VIRSH + ["list", "--name"], capture_output=True, text=True, timeout=5).stdout
        s["running"] = {l.strip() for l in out.splitlines() if l.strip()}
    except (OSError, subprocess.TimeoutExpired):
        pass
    s["apps"] = pgrep_user("xfreerdp3 .*/app:")
    s["rdp_desktop"] = pgrep_user("xfreerdp3 .*(Microsoft Windows|Windows RDP Session)")
    s["net"] = read_net()
    s["hdmi"] = read_hdmi()
    s["deskflow"] = read_deskflow()
    s["no_lg"] = os.path.exists(NO_LG_PREF)
    s["lg"] = pgrep_user("looking-glass-client")
    try:
        s["log"] = subprocess.run(["journalctl", "-t", "gpu-mode", "-n", "14", "-o", "short", "--no-pager", "-q"],
                                  capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return s


def read_net():
    """Wi-Fi devices: [{kind: internal|dongle, dev, state, conn, ip}]. Internal = BCM4360 at 09:00.0."""
    out = []
    try:
        lines = subprocess.run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"],
                               capture_output=True, text=True, timeout=5).stdout.splitlines()
    except (OSError, subprocess.TimeoutExpired):
        return out
    for l in lines:
        f = l.replace("\\:", "\x00").split(":")
        if len(f) < 4 or f[1] != "wifi":
            continue
        dev, state, conn = f[0], f[2], f[3].replace("\x00", ":")
        path = os.path.realpath(f"/sys/class/net/{dev}/device")
        ip = ""
        try:
            a = subprocess.run(["ip", "-4", "-br", "addr", "show", "dev", dev], capture_output=True, text=True).stdout.split()
            ip = a[2].split("/")[0] if len(a) > 2 else ""
        except OSError:
            pass
        out.append({"kind": "internal" if "0000:09:00.0" in path else "dongle", "dev": dev,
                    "state": state, "conn": conn, "ip": ip})
    return out


def winapps_entries():
    """App-grid entries made by WinApps (laptop/host/winapps): [(name, app id, icon path)]."""
    out = []
    for f in sorted(glob.glob(os.path.expanduser("~/.local/share/applications/*.desktop"))):
        d = {}
        try:
            for line in open(f):
                if "=" in line and not line.startswith("#"):
                    k, v = line.rstrip("\n").split("=", 1)
                    d.setdefault(k, v)
        except OSError:
            continue
        ex = d.get("Exec", "").split()
        if len(ex) >= 2 and ex[0].endswith(("/winapps", "/winapps-sync")) and ex[-2 if ex[-1] == "%F" else -1] != "windows":
            aid = ex[2] if ex[0].endswith("winapps-sync") else ex[1]
            out.append((d.get("Name", aid), aid, d.get("Icon", "")))
    names = [o[0] for o in out]
    nice = {"powershell-ide": "PowerShell ISE", "powershell": "PowerShell", "iexplorer": "Internet Explorer", "cmd": "Command Prompt"}
    return [(nice.get(a, n if names.count(n) == 1 else f"{n} ({a})"), a, i) for n, a, i in out]


def set_pill(pill, text, kind):
    pill.set_label(text)
    for k in ("on", "off", "busy"):
        pill.remove_css_class(k)
    pill.add_css_class(kind)


def set_button_box(box, specs):
    """Populate a Gtk.Box with pill buttons from [(label, style_or_None, callback_or_None)]."""
    while (c := box.get_first_child()):
        box.remove(c)
    for label, style, cb in specs:
        b = Gtk.Button(label=label)
        b.add_css_class("pill")
        if style:
            b.add_css_class(style)
        if cb:
            b.connect("clicked", lambda _b, f=cb: f())
        else:
            b.set_sensitive(False)
        box.append(b)


class OsCard(Gtk.Box):
    """Big card: icon, name, state pill, one-line explanation, buttons."""

    def __init__(self, icon, title):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=10, hexpand=True)
        self.add_css_class("card")
        self.add_css_class("os-card")
        top = Gtk.Box(spacing=12)
        img = Gtk.Image.new_from_icon_name(icon)
        img.set_pixel_size(40)
        top.append(img)
        self.title = Gtk.Label(label=title, xalign=0, hexpand=True)
        self.title.add_css_class("os-title")
        top.append(self.title)
        self.pill = Gtk.Label()
        self.pill.add_css_class("pill")
        self.pill.set_valign(Gtk.Align.CENTER)
        top.append(self.pill)
        self.append(top)
        self.info = Gtk.Label(xalign=0, wrap=True)
        self.info.add_css_class("dim-label")
        self.append(self.info)
        self.buttons = Gtk.Box(spacing=8, margin_top=4)
        self.append(self.buttons)

    def set_state(self, text, kind, info):
        set_pill(self.pill, text, kind)
        self.info.set_label(info)

    def set_buttons(self, specs):
        set_button_box(self.buttons, specs)


