#!/usr/bin/env python3
# VM Switch - one window to see and switch what runs on the laptop: Linux, Windows on the GTX 1650
# (Looking Glass window), macOS on the laptop screen (iGPU), plus the VNC-only VMs.
# Uses gpu-mode (through pkexec, policy local.kvm.gpu-mode) for GPU switches, virsh (group libvirt)
# for the plain VMs, win-gpu for the Looking Glass window, nitro-control for fans and RGB.
import fcntl, glob, os, shutil, subprocess, sys, threading, time
# Draw with the Intel iGPU only. GTK4 otherwise opens the GTX (NVIDIA EGL/Vulkan) and holds /dev/nvidia*,
# which blocks `gpu-mode win` from moving the GTX to Windows ("programs still use the GTX: python3").
os.environ["__EGL_VENDOR_LIBRARY_FILENAMES"] = "/usr/share/glvnd/egl_vendor.d/50_mesa.json"
os.environ["VK_DRIVER_FILES"] = "/usr/share/vulkan/icd.d/intel_icd.json"
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk

VIRSH = ["virsh", "-c", "qemu:///system"]
GPU_MODE = "/usr/local/sbin/gpu-mode"
IGPU, GTX = "0000:00:02.0", "0000:01:00.0"
VNC = {"macos": 5902, "win10": 5903}

