#!/bin/bash
# gpu-mode - switch the laptop's Intel iGPU (00:02.0) between the host and the macOS VM.
#   sudo gpu-mode mac      stop GDM, bind iGPU to vfio-pci, start macos-igpu (macOS on the laptop panel)
#   sudo gpu-mode mac --radios  also give macOS the Wi-Fi + Bluetooth (experimental; Linux keeps only a USB dongle)
#   sudo gpu-mode mac --wifi    only the Wi-Fi
#   sudo gpu-mode mac --nvme    real Samsung NVMe passthrough (faster; ONLY with hibernation off in macOS)
#   sudo gpu-mode net-backup    copy the current Wi-Fi profile to a USB Wi-Fi dongle (Linux network in mac --radios)
#   sudo gpu-mode host     stop macos-igpu, give the iGPU back to i915, start GDM
#   sudo gpu-mode win      give the GTX 1650 to win10-gpu (Linux keeps the panel; view: looking-glass-client)
#   sudo gpu-mode win-off  stop win10-gpu, GTX 1650 back to nvidia
#   sudo gpu-mode hdmi-on [--restart] [--stop-win]   enable external HDMI on CachyOS GNOME (reloads GDM on --restart)
#   sudo gpu-mode hdmi-off [--restart]               re-enable GNOME GTX isolation for `win-gpu`
#   sudo gpu-mode status
#   sudo gpu-mode new-overlay  discard the macOS VM disk overlay (done automatically by `mac` after a native boot)
#   Apple menu > Shut Down in macOS also returns to the host (libvirt hook + watchdog).
# Runs only on request. Nothing here is persistent: a reboot always returns to host mode.
# In mac mode the host has no display (the panel is wired to the iGPU; the GTX 1650 only drives
# the HDMI port). Manage the host over SSH. Keyboard/touchpad: both Ctrl keys toggle host/guest.
# If `host` cannot rebind i915 (iGPU left in a bad state by the guest), reboot the laptop.
set -uo pipefail
# Never die halfway through a switch because the caller closed stdout (e.g. `gpu-mode host | head -1`).
trap '' PIPE
# `sudo gpu-mode mac` over SSH: the Wi-Fi goes to macOS and the SSH session drops. Keep running.
trap '' HUP
IGPU=0000:00:02.0
VM=macos-igpu
GUEST_IP=192.168.122.11
DEV=/sys/bus/pci/devices/$IGPU

log() { echo "[gpu-mode] $*"; logger -t gpu-mode "$*" 2>/dev/null || true; }
die() { log "ERROR: $*"; exit 1; }
drv() { local l; l=$(readlink "$DEV/driver" 2>/dev/null) && basename "$l" || echo none; }
state() { virsh domstate "$1" 2>/dev/null || echo "undefined"; }
BL=/sys/class/backlight/intel_backlight
save_bl() { cat "$BL/brightness" > /run/gpu-mode-brightness 2>/dev/null || true; }
# After the guest had the iGPU, i915 comes back with backlight 0 (screen looks black). Restore it.
restore_bl() {
  local b; b=$(cat /run/gpu-mode-brightness 2>/dev/null || echo 0)
  [ "${b:-0}" -gt 0 ] 2>/dev/null || b=$(( $(cat "$BL/max_brightness") * 6 / 10 ))
  for i in 1 2 3 4 5; do [ -w "$BL/brightness" ] && echo "$b" > "$BL/brightness" && break; sleep 1; done
}
# A native macOS boot rewrites the Samsung disk under nvme1-overlay.qcow2, and the VM then sees a mix of
# old and new APFS blocks (2026-11-22: OpenCore "Halting on critical error", only vCPU0 running).
# Fingerprint = the APFS container superblock (block 0) plus the checkpoint descriptor area of every
# APFS partition; every native mount writes a new checkpoint there. The VM never writes the base disk.
OVERLAY=/var/lib/libvirt/images/macos/nvme1-overlay.qcow2
OVERLAY_FP=$OVERLAY.base-fp
apfs_fp() {
  local p
  for p in $(lsblk -lnpo NAME,PARTTYPE /dev/hackintosh-disk | awk 'tolower($2)=="7c3457ef-0000-11aa-aa11-00306543ecac"{print $1}'); do
    python3 -I - "$p" <<'PY' || return 1
import hashlib, struct, sys
with open(sys.argv[1], 'rb') as f:
    sb = f.read(4096)
    if sb[32:36] != b'NXSB':
        sys.exit(1)
    bs, = struct.unpack_from('<I', sb, 36)
    blocks, = struct.unpack_from('<I', sb, 104)
    base, = struct.unpack_from('<q', sb, 112)
    h = hashlib.sha256(sb)
    if not blocks & 0x80000000 and 0 < blocks <= 1024:
        f.seek(base * bs)
        h.update(f.read(blocks * bs))
    print(sys.argv[1], h.hexdigest())
PY
  done | sha256sum | cut -c1-32
}
new_overlay() {
  local fp
  fp=$(apfs_fp) || die "cannot read the APFS container on /dev/hackintosh-disk"
  rm -f "$OVERLAY"
  qemu-img create -q -f qcow2 -b /dev/hackintosh-disk -F raw "$OVERLAY" || die "qemu-img create failed"
  chown libvirt-qemu:libvirt-qemu "$OVERLAY"
  echo "$fp" > "$OVERLAY_FP"
  log "new overlay on /dev/hackintosh-disk (fingerprint $fp)"
}
# Recreate the overlay when the Hackintosh disk changed since it was made (= a native boot happened).
check_overlay() {
  local fp
  fp=$(apfs_fp) || die "cannot read the APFS container on /dev/hackintosh-disk"
  if [ ! -f "$OVERLAY" ]; then
    new_overlay
  elif [ ! -f "$OVERLAY_FP" ]; then
    echo "$fp" > "$OVERLAY_FP"
    log "overlay fingerprint recorded ($fp); if macOS was booted natively since the overlay was made, run: sudo gpu-mode new-overlay"
  elif [ "$(cat "$OVERLAY_FP")" != "$fp" ]; then
    log "Hackintosh disk changed since the overlay was made (native macOS boot): discarding the overlay"
    new_overlay
  fi
}
# Apple BCM4360 Wi-Fi (PCI 09:00.0, own IOMMU group) and Apple Bluetooth (USB 05ac:828f) for macOS,
# so Continuity / Universal Control work. libvirt (managed='yes') takes them from wl/btusb at start and gives
# them back at shutdown. Linux has no network while macOS runs (wlan0 is its only link, Ethernet unplugged).
# Opt-in: `gpu-mode mac --radios` (2026-11-22: macOS hung at the Apple logo with them, still being debugged).
# Without the flag both stay with Linux. Added to/removed from the persistent domain before start.
RADIO_PCI="<hostdev mode='subsystem' type='pci' managed='yes'><source><address domain='0x0000' bus='0x09' slot='0x00' function='0x0'/></source><address type='pci' domain='0x0000' bus='0x00' slot='0x0a' function='0x0'/></hostdev>"
RADIO_USB="<hostdev mode='subsystem' type='usb' managed='yes'><source><vendor id='0x05ac'/><product id='0x828f'/></source></hostdev>"
set_radios() {   # $1 = on|off
  local x f; x=$(virsh dumpxml --inactive "$VM")
  for f in "$RADIO_PCI" "$RADIO_USB"; do
    local has=0 want=$1
    # --wifi: Wi-Fi only, Bluetooth stays with Linux
    [ "$1" = wifi ] && { case "$f" in *"bus='0x09'"*) want=on ;; *) want=off ;; esac; }
    case "$f" in *"bus='0x09'"*) grep -q "bus='0x09' slot='0x00'" <<<"$x" && has=1 ;; *) grep -q "product id='0x828f'" <<<"$x" && has=1 ;; esac
    if [ "$want" = on ] && [ $has = 0 ]; then echo "$f" > /run/gpu-mode-dev.xml; virsh attach-device "$VM" /run/gpu-mode-dev.xml --config >/dev/null || die "attach radio failed"
    elif [ "$want" = off ] && [ $has = 1 ]; then echo "$f" > /run/gpu-mode-dev.xml; virsh detach-device "$VM" /run/gpu-mode-dev.xml --config >/dev/null || die "detach radio failed"; fi
  done
  rm -f /run/gpu-mode-dev.xml
}
# Wi-Fi interfaces: the internal BCM4360 (09:00.0) and any other (USB dongle).
wifi_ifaces() {  # prints "internal|dongle name"
  local d
  for d in /sys/class/net/*; do
    [ -d "$d/wireless" ] || [ -d "$d/phy80211" ] || continue
    case "$(readlink -f "$d/device")" in *0000:09:00.0*) echo "internal ${d##*/}" ;; *) echo "dongle ${d##*/}" ;; esac
  done
}
net_backup() {
  local int dongle prof new
  int=$(wifi_ifaces | awk '$1=="internal"{print $2; exit}')
  dongle=$(wifi_ifaces | awk '$1=="dongle"{print $2; exit}')
  [ -n "$dongle" ] || die "no USB Wi-Fi dongle found: plug it in first"
  [ -n "$int" ] || die "internal Wi-Fi not found (is it with macOS?)"
  prof=$(nmcli -t -f NAME,DEVICE connection show --active | awk -F: -v d="$int" '$NF==d{sub(":" d "$", ""); print; exit}')
  [ -n "$prof" ] || die "internal Wi-Fi ($int) is not connected: connect it first"
  new="$prof (dongle)"
  nmcli -t -f NAME connection show | grep -qxF "$new" || nmcli connection clone "$prof" "$new" >/dev/null || die "clone failed"
  nmcli connection modify "$new" connection.interface-name "$dongle" connection.autoconnect yes \
    802-11-wireless.mac-address "" ipv4.route-metric 700 ipv6.route-metric 700 || die "modify failed"
  nmcli connection modify "$prof" connection.interface-name "$int" || true
  nmcli connection up "$new" ifname "$dongle" >/dev/null || die "the dongle did not connect to $prof"
  log "backup network: $dongle on $prof ($(ip -4 -br addr show dev "$dongle" | awk '{print $3}'))"
}
# Headless Linux desktop over RDP while macOS has the screen (laptop/host/headless-rdp/setup.sh).
DESKTOP_USER=$(id -nu 1000 2>/dev/null)
rdp_on()  { [ -f /etc/systemd/user/linux-headless-rdp.target ] || return 0
            systemctl --user -M "$DESKTOP_USER@" start linux-headless-rdp.target >/dev/null 2>&1 \
              && log "Linux desktop over RDP: port 3389, user $DESKTOP_USER" || log "WARN: headless RDP did not start"; }
rdp_off() { [ -f /etc/systemd/user/linux-headless-rdp.target ] || return 0
            systemctl --user -M "$DESKTOP_USER@" stop linux-headless-rdp.target linux-headless-shell.service \
              gnome-remote-desktop-headless.service >/dev/null 2>&1 || true; }
# macOS disk: the copy-on-write overlay (default; the real disk is only read) or, opt-in with `mac --nvme`, the real
# Samsung 980 NVMe controller. --nvme needs hibernation off in macOS (hibernatemode 0, standby 0, autopoweroff 0):
# VM and native boot have separate NVRAM, a native resume from an old sleepimage after VM writes corrupts the disk.
# Linux must not have anything on the Samsung mounted, open or in use as swap when macOS takes it.
NVME_PCI=0000:07:00.0
DISK_NVME="<hostdev mode='subsystem' type='pci' managed='yes'><source><address domain='0x0000' bus='0x07' slot='0x00' function='0x0'/></source><address type='pci' domain='0x0000' bus='0x00' slot='0x0b' function='0x0'/></hostdev>"
DISK_OVERLAY="<disk type='file' device='disk'><driver name='qemu' type='qcow2' cache='writeback'/><source file='/var/lib/libvirt/images/macos/nvme1-overlay.qcow2'/><backingStore type='block'><format type='raw'/><source dev='/dev/hackintosh-disk'/></backingStore><target dev='sdb' bus='sata'/></disk>"
nvme_safe() {
  local dev p
  [ "$(lsblk -dno MODEL /dev/hackintosh-disk 2>/dev/null)" = "Samsung SSD 980 1TB" ] || die "/dev/hackintosh-disk is not the Samsung 980"
  dev=$(readlink -f /dev/hackintosh-disk)
  [ "$(basename "$(readlink -f "/sys/block/${dev##*/}/device/device")")" = "$NVME_PCI" ] \
    || die "the Samsung 980 is not at $NVME_PCI (PCI layout changed?): not passing anything through"
  [ -z "$(lsblk -no MOUNTPOINTS "$dev" | tr -d '[:space:]')" ] || die "Linux has a Samsung partition mounted: $(lsblk -no NAME,MOUNTPOINTS "$dev" | tr '\n' ' ')"
  for p in "$dev" "$dev"p*; do
    [ -e "$p" ] || continue
    grep -q "^$p " /proc/swaps && die "$p is in use as swap"
    fuser -s "$p" 2>/dev/null && die "a Linux process has $p open: $(fuser -v "$p" 2>&1 | tail -n +2 | tr -s ' ' | tr '\n' ' ')"
  done
  return 0
}
set_disk() {   # $1 = nvme|overlay, in the persistent domain
  local x; x=$(virsh dumpxml --inactive "$VM")
  if [ "$1" = nvme ]; then
    grep -q "<target dev='sdb'" <<<"$x" && { virsh detach-disk "$VM" sdb --config >/dev/null || die "detach overlay disk failed"; }
    if ! grep -q "bus='0x07' slot='0x00'" <<<"$x"; then
      echo "$DISK_NVME" > /run/gpu-mode-dev.xml; virsh attach-device "$VM" /run/gpu-mode-dev.xml --config >/dev/null || die "attach NVMe failed"
    fi
  else
    if grep -q "bus='0x07' slot='0x00'" <<<"$x"; then
      echo "$DISK_NVME" > /run/gpu-mode-dev.xml; virsh detach-device "$VM" /run/gpu-mode-dev.xml --config >/dev/null || die "detach NVMe failed"
    fi
    if ! grep -q "<target dev='sdb'" <<<"$x"; then
      echo "$DISK_OVERLAY" > /run/gpu-mode-dev.xml; virsh attach-device "$VM" /run/gpu-mode-dev.xml --config >/dev/null || die "attach overlay disk failed"
    fi
  fi
  rm -f /run/gpu-mode-dev.xml
}
TP_UNIT=gpu-mode-touchpad
TP_DEV=/dev/input/gpu-mode-touchpad
# Touchpad -> virtual mouse with tap-to-click for the VM (host/touchpad-bridge).
tp_start() {
  systemctl is-active -q $TP_UNIT && return 0
  systemctl reset-failed $TP_UNIT 2>/dev/null
  systemd-run -q --unit=$TP_UNIT /usr/local/sbin/touchpad-bridge || return 1
  for i in $(seq 1 10); do [ -e $TP_DEV ] && return 0; sleep 0.5; done
  return 1
}
tp_stop() { systemctl stop $TP_UNIT 2>/dev/null; true; }

# macOS on the iGPU never powers the VM off after Apple menu > Shut Down: all vCPUs spin on one
# kernel address (2026-11-19). Watchdog: once macOS was up, if it stops answering ping and CPU 0
# sits on the same RIP, not halted, for 20 s, force the VM off. The libvirt hook then runs
# `gpu-mode host`. A normal reboot changes RIP and an idle/sleeping guest is halted (HLT=1).
WD_UNIT=gpu-mode-watchdog
rip() { virsh qemu-monitor-command --hmp "$VM" "info registers" 2>/dev/null | grep -oE 'RIP=[0-9a-f]+|HLT=[01]' | tr '\n' ' '; }
watchdog() {
  local seen=0 last="" same=0 r
  while [ "$(state $VM)" = running ]; do
    sleep 5
    if ping -c1 -W1 "$GUEST_IP" >/dev/null 2>&1; then seen=1; same=0; last=""; continue; fi
    [ $seen = 1 ] || continue
    r=$(rip)
    if [ -n "$r" ] && [ "$r" = "$last" ] && [[ "$r" == *HLT=0* ]]; then same=$((same + 1)); else same=0; fi
    last=$r
    if [ $same -ge 4 ]; then
      log "watchdog: macOS stuck after shutdown ($r), forcing $VM off"
      virsh destroy "$VM" >/dev/null; return 0
    fi
  done
}
wd_start() { systemctl reset-failed $WD_UNIT 2>/dev/null; systemd-run -q --unit=$WD_UNIT /usr/local/sbin/gpu-mode watchdog || true; }
wd_stop() { systemctl stop $WD_UNIT 2>/dev/null; true; }
vtcon() { for v in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" "$v/name" 2>/dev/null && echo "$1" > "$v/bind" 2>/dev/null; done; true; }

[ "$(id -u)" = 0 ] || die "run with sudo"
# One switch at a time (the libvirt hook also runs `gpu-mode host` when macos-igpu stops).
[ "${1:-}" = watchdog ] && { watchdog; exit 0; }
# mac-bg / hdmi-*-bg: run as their own system unit so the switch survives the end of the GNOME session.
[ "${1:-}" = mac-bg ] && exec systemd-run -q --collect --unit=gpu-mode-switch /usr/local/sbin/gpu-mode mac "${@:2}"
[ "${1:-}" = hdmi-on-bg ] && exec systemd-run -q --collect --unit=gpu-mode-hdmi /usr/local/sbin/gpu-mode hdmi-on --restart "${@:2}"
[ "${1:-}" = hdmi-off-bg ] && exec systemd-run -q --collect --unit=gpu-mode-hdmi /usr/local/sbin/gpu-mode hdmi-off --restart "${@:2}"
exec 9>/run/gpu-mode.lock
flock -w 300 9 || die "another gpu-mode is still running"

status() {
  echo "iGPU $IGPU driver: $(drv)"
  echo "GTX  $GTX driver: $(pdrv $GTX)"
  echo "gdm: $(systemctl is-active gdm)"
  for d in macos macos-igpu win10 $WVM; do echo "VM $d: $(state $d)"; done
}

# --- GTX 1650 <-> Windows (win10-gpu). Independent of the iGPU switch above. ---
# GNOME never opens the GTX (host/udev/63-gtx-no-gnome.rules + gnome-shell EGL drop-in), so the
# nvidia modules can be unloaded without a logout. Unloading (not unbinding) fails cleanly with
# "in use" instead of hanging when something still holds the GPU.
GTX=0000:01:00.0
GTXA=0000:01:00.1
WVM=win10-gpu
pdrv() { local l; l=$(readlink "/sys/bus/pci/devices/$1/driver" 2>/dev/null) && basename "$l" || echo none; }
NV_MODS="nvidia_drm nvidia_uvm nvidia_modeset nvidia"
GTXPORT=0000:00:01.0
# Optimus: the GTX and its HDMI audio runtime-suspend (D3). Unbinding the audio function while it
# slept froze the whole host (2026-11-20). Keep root port + both functions powered while switching.
gtx_pin_power() { for d in $GTXPORT $GTX $GTXA; do echo "$1" > /sys/bus/pci/devices/$d/power/control; done; }

gtx_to_host() {
  for d in $GTX $GTXA; do
    echo > /sys/bus/pci/devices/$d/driver_override
    [ "$(pdrv $d)" = vfio-pci ] && echo $d > /sys/bus/pci/drivers/vfio-pci/unbind
  done
  modprobe nvidia_drm; modprobe nvidia_uvm
  for d in $GTX $GTXA; do [ "$(pdrv $d)" = none ] && echo $d > /sys/bus/pci/drivers_probe 2>/dev/null; done
  gtx_pin_power auto
  systemctl start nvidia-powerd 2>/dev/null
  log "GTX back on $(pdrv $GTX), audio on $(pdrv $GTXA)"
}

to_win() {
  [ "$(state $WVM)" = running ] && { log "$WVM already running"; return 0; }
  [ "$(state win10)" = "shut off" ] || die "domain 'win10' is running: it shares the disk, shut it down first"
  for f in gtx1650.rom ssdt-battery.aml win10.qcow2; do
    [ -f /var/lib/libvirt/images/win10/$f ] || die "/var/lib/libvirt/images/win10/$f missing (run host/01-host-setup.sh)"
  done
  if [ "$(pdrv $GTX)" != vfio-pci ]; then
    gtx_pin_power on; sleep 1
    systemctl stop nvidia-powerd 2>/dev/null
    users=$(fuser /dev/nvidia* 2>/dev/null | xargs)
    if [ -n "$users" ]; then
      systemctl start nvidia-powerd 2>/dev/null
      die "programs still use the GTX (log out and in once if they are desktop services), close them first: $(ps -o args= -p ${users// /,} | cut -c1-60 | sort -u | paste -sd ';' | sed 's/;/; /g')"
    fi
    for m in $NV_MODS; do
      lsmod | grep -q "^$m " || continue
      # rmmod, not modprobe -r: modprobe also tries to drop shared deps (i915) and then reports failure
      rmmod $m 2>/dev/null || { gtx_to_host; die "cannot unload $m (still in use — if Linux HDMI is active, switch External HDMI back to Windows passthrough mode first)"; }
    done
    modprobe vfio-pci
    # audio first (it keeps snd_hda_intel after nvidia is gone), then GPU, then audio to vfio
    [ "$(pdrv $GTXA)" = none ] || timeout 20 sh -c "echo $GTXA > /sys/bus/pci/devices/$GTXA/driver/unbind" || { gtx_to_host; die "HDMI audio unbind hung"; }
    for d in $GTX $GTXA; do
      echo vfio-pci > /sys/bus/pci/devices/$d/driver_override
      timeout 20 sh -c "echo $d > /sys/bus/pci/drivers_probe" 2>/dev/null
    done
    [ "$(pdrv $GTX)" = vfio-pci ] && [ "$(pdrv $GTXA)" = vfio-pci ] || { gtx_to_host; die "GTX did not bind to vfio-pci"; }
  fi
  systemd-tmpfiles --create /etc/tmpfiles.d/looking-glass.conf
  log "GTX on vfio-pci, starting $WVM"
  virsh start $WVM || { gtx_to_host; die "virsh start $WVM failed, GTX back to host"; }
  log "Windows starting. View: win-gpu on the laptop desktop (Looking Glass window)"
}

to_win_off() {
  if [ "$(state $WVM)" = running ]; then
    log "shutting down $WVM"
    virsh shutdown $WVM >/dev/null
    for i in $(seq 1 18); do [ "$(state $WVM)" = "shut off" ] && break; sleep 5; done
    [ "$(state $WVM)" = "shut off" ] || { log "forcing off"; virsh destroy $WVM >/dev/null; }
  fi
  [ "$(pdrv $GTX)" = vfio-pci ] && gtx_to_host
  true
}

HDMI_UDEV=/etc/udev/rules.d/63-gtx-no-gnome.rules
HDMI_DROPIN=/etc/systemd/user/org.gnome.Shell@wayland.service.d/10-no-nvidia-egl.conf
HDMI_SYS_ENV=/etc/environment.d/90-gtx-free.conf

hdmi_user() {
  local u="${DESKTOP_USER:-}"
  [ -n "$u" ] || u=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$3!="gdm"&&$3!="root"&&$3!=""{print $3;exit}')
  printf '%s' "$u"
}

hdmi_wait_gtx_free() {
  local tries=$1 card devs i
  card=$(ls -d /sys/bus/pci/devices/$GTX/drm/card[0-9]* 2>/dev/null | head -1)
  devs=(/dev/nvidia*)
  [ -n "$card" ] && [ -e "/dev/dri/${card##*/}" ] && devs+=("/dev/dri/${card##*/}")
  for i in $(seq 1 "$tries"); do
    fuser -s "${devs[@]}" 2>/dev/null || return 0
    sleep 1
  done
  return 1
}

hdmi_user_env() {
  local u="$1" uid bus
  shift
  [ -n "$u" ] || return 0
  uid=$(id -u "$u" 2>/dev/null || true)
  bus="/run/user/$uid/bus"
  if [ -n "$uid" ] && [ -S "$bus" ]; then
    runuser -u "$u" -- env "XDG_RUNTIME_DIR=/run/user/$uid" "DBUS_SESSION_BUS_ADDRESS=unix:path=$bus" systemctl --user "$@" 2>/dev/null || true
  else
    systemctl --user -M "$u@" "$@" 2>/dev/null || true
  fi
}

hdmi_reload_drm() {
  local tries=${1:-1} m
  [ "$(pdrv $GTX)" = nvidia ] || return 0
  gtx_pin_power on
  systemctl stop nvidia-powerd 2>/dev/null || true
  if ! hdmi_wait_gtx_free "$tries"; then
    local card devs
    card=$(ls -d /sys/bus/pci/devices/$GTX/drm/card[0-9]* 2>/dev/null | head -1)
    devs=(/dev/nvidia*)
    [ -n "$card" ] && [ -e "/dev/dri/${card##*/}" ] && devs+=("/dev/dri/${card##*/}")
    log "GTX held open by: $(fuser -v "${devs[@]}" 2>&1 | tail -n +2 | tr -s ' ' | tr '\n' ' '); skipping nvidia_drm reload"
    gtx_pin_power auto
    systemctl start nvidia-powerd 2>/dev/null || true
    return 1
  fi
  for m in $NV_MODS; do
    lsmod | grep -q "^$m " || continue
    rmmod "$m" 2>/dev/null || { gtx_to_host; log "WARN: could not unload $m for udev refresh"; return 1; }
  done
  gtx_to_host
  udevadm settle 2>/dev/null || true
  return 0
}

hdmi_restore_locks() {
  if [ -e "${HDMI_UDEV}.disabled" ]; then mv -f "${HDMI_UDEV}.disabled" "$HDMI_UDEV"
  elif [ ! -e "$HDMI_UDEV" ]; then
    cat > "$HDMI_UDEV" <<'EOF'
# GNOME (mutter) never drives the GTX 1650 (01:00.0), so it can go to the Windows VM without a logout.
# Cost: Linux shows nothing on the HDMI port (wired to the GTX). CUDA / PRIME offload still work while
# Windows is off. Takes effect after the next GNOME login.
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", KERNELS=="0000:01:00.0", TAG+="mutter-device-ignore"
EOF
  fi
  chmod 644 "$HDMI_UDEV"
  mkdir -p "$(dirname "$HDMI_DROPIN")" "$(dirname "$HDMI_SYS_ENV")"
  if [ -e "${HDMI_DROPIN}.disabled" ]; then mv -f "${HDMI_DROPIN}.disabled" "$HDMI_DROPIN"
  elif [ ! -e "$HDMI_DROPIN" ]; then
    cat > "$HDMI_DROPIN" <<'EOF'
[Service]
Environment=__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
EOF
  fi
  chmod 644 "$HDMI_DROPIN"
  if [ -e "${HDMI_SYS_ENV}.disabled" ]; then mv -f "${HDMI_SYS_ENV}.disabled" "$HDMI_SYS_ENV"
  elif [ ! -e "$HDMI_SYS_ENV" ]; then
    cat > "$HDMI_SYS_ENV" <<'EOF'
__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
VK_DRIVER_FILES=/usr/share/vulkan/icd.d/intel_icd.json
EOF
  fi
  chmod 644 "$HDMI_SYS_ENV"
}

to_hdmi_on() {
  local u h uenv f
  if [ "$(state $WVM)" = running ]; then
    [ "$HDMI_STOP_WIN" = 1 ] || die "Windows ($WVM) owns the GTX 1650; shut down Windows first"
    to_win_off
  fi
  u=$(hdmi_user); h=$(getent passwd "$u" 2>/dev/null | cut -d: -f6 || true)
  uenv=${h:+"$h/.config/environment.d/90-gtx-free.conf"}
  for f in "$HDMI_UDEV" "$HDMI_DROPIN" "$HDMI_SYS_ENV" ${uenv:+"$uenv"}; do
    [ -e "$f" ] && mv -f "$f" "${f}.disabled"
  done
  hdmi_user_env "$u" unset-environment __EGL_VENDOR_LIBRARY_FILENAMES VK_DRIVER_FILES
  udevadm control --reload
  if [ "$HDMI_RESTART" = 1 ]; then
    log "enabling Linux HDMI (restarting GDM and nvidia_drm)"
    trap 'systemctl start gdm 2>/dev/null || true' EXIT
    systemctl stop gdm; sleep 1
    hdmi_reload_drm 15 || true
    systemctl start gdm; trap - EXIT
    log "Linux HDMI ready (GDM restarted; log in to use external display)"
  else
    hdmi_reload_drm 1 || true
    log "Linux HDMI locks removed (log out and back in to attach GNOME to HDMI)"
  fi
}

to_hdmi_off() {
  local u h uenv
  u=$(hdmi_user); h=$(getent passwd "$u" 2>/dev/null | cut -d: -f6 || true)
  uenv=${h:+"$h/.config/environment.d/90-gtx-free.conf"}
  hdmi_restore_locks
  [ -n "$uenv" ] && [ -e "$uenv" ] && mv -f "$uenv" "${uenv}.disabled"
  hdmi_user_env "$u" set-environment \
    __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json \
    VK_DRIVER_FILES=/usr/share/vulkan/icd.d/intel_icd.json
  udevadm control --reload
  if [ "$HDMI_RESTART" = 1 ]; then
    log "restoring Windows passthrough mode (restarting GDM)"
    trap 'systemctl start gdm 2>/dev/null || true' EXIT
    systemctl stop gdm; sleep 1
    hdmi_reload_drm 15 || true
    systemctl start gdm; trap - EXIT
    log "Windows passthrough mode ready (GDM restarted; GNOME off GTX)"
  else
    udevadm trigger --action=add --subsystem-match=drm 2>/dev/null || true
    log "Windows passthrough locks restored (log out and back in before win-gpu)"
  fi
}

to_mac() {
  [ "$(state $VM)" = "running" ] && { log "$VM already running"; status; return 0; }
  [ -d /sys/kernel/iommu_groups/0 ] || die "IOMMU off (need intel_iommu=on on the kernel cmdline)"
  [ "$(state macos)" = "shut off" ] || die "domain 'macos' is running: it shares the disk overlay, shut it down first"
  [ "$(state $VM)" = "shut off" ] || die "$VM is $(state $VM)"
  [ -f /var/lib/libvirt/images/macos/opencore-igpu.img ] || die "opencore-igpu.img missing"
  if [ "$DISK" = nvme ]; then
    nvme_safe
    set_disk nvme
    log "macOS gets the real Samsung 980 (NVMe passthrough): Linux loses /dev/hackintosh-disk until macOS stops"
  else
    # NVMe numbering swaps between boots: the overlay must sit on the Samsung, never on the host disk.
    [ "$(lsblk -dno MODEL /dev/hackintosh-disk 2>/dev/null)" = "Samsung SSD 980 1TB" ] || die "/dev/hackintosh-disk is not the Samsung 980"
    set_disk overlay
    check_overlay
    qemu-img info -U "$OVERLAY" 2>/dev/null | grep -q 'backing file: /dev/hackintosh-disk' || die "overlay is not backed by /dev/hackintosh-disk"
  fi
  if [ "$RADIOS" != off ]; then
    lspci -s 09:00.0 -n | grep -q '14e4:43a0' || die "Wi-Fi 09:00.0 is not the BCM4360"
    set_radios "$RADIOS"
    wifi_ifaces | grep -q '^dongle' || log "WARN: no USB Wi-Fi dongle: Linux has no network while macOS runs"
    log "Wi-Fi + Bluetooth go to macOS (experimental). Back: Apple menu > Shut Down"
  else
    set_radios off
  fi

  save_bl
  log "stopping GDM (host desktop closes)"
  systemctl stop gdm
  for i in $(seq 1 20); do
    card=$(ls -d "$DEV"/drm/card* 2>/dev/null | head -1)
    [ -z "$card" ] && break
    fuser -s "/dev/dri/$(basename "$card")" 2>/dev/null || break
    sleep 1
  done
  vtcon 0

  if [ "$(drv)" = i915 ]; then
    log "unbinding i915"
    timeout 30 sh -c "echo $IGPU > /sys/bus/pci/drivers/i915/unbind" || { to_host_hw; die "i915 unbind failed/hung"; }
  fi
  modprobe vfio-pci
  echo vfio-pci > "$DEV/driver_override"
  echo "$IGPU" > /sys/bus/pci/drivers_probe 2>/dev/null
  [ "$(drv)" = vfio-pci ] || { to_host_hw; die "iGPU did not bind to vfio-pci (driver: $(drv))"; }
  tp_start || { to_host_hw; die "touchpad bridge did not start ($TP_DEV missing)"; }
  log "iGPU on vfio-pci, starting $VM"

  if ! virsh start "$VM"; then to_host_hw; die "virsh start failed, host restored"; fi
  wd_start
  rdp_on
  for i in $(seq 1 36); do
    sleep 5
    [ "$(state $VM)" = running ] || { to_host_hw; die "$VM stopped during boot, host restored"; }
    ping -c1 -W1 "$GUEST_IP" >/dev/null 2>&1 && { log "macOS up at $GUEST_IP after $((i*5))s"; return 0; }
  done
  log "WARN: no ping from macOS after 180s; it may still be booting. Check: sudo gpu-mode status, serial log /var/lib/libvirt/qemu/$VM-serial.log. Back to host: sudo gpu-mode host"
}

to_host_hw() {
  rdp_off   # before GDM: the headless shell must not run next to the real session
  tp_stop
  wd_stop
  echo > "$DEV/driver_override"
  if [ "$(drv)" = vfio-pci ]; then echo "$IGPU" > /sys/bus/pci/drivers/vfio-pci/unbind; fi
  if [ "$(drv)" = none ]; then timeout 60 sh -c "echo $IGPU > /sys/bus/pci/drivers_probe" 2>/dev/null; fi
  vtcon 1
  if [ "$(drv)" = i915 ]; then
    restore_bl
    systemctl start gdm
    sleep 3; restore_bl
    log "host mode: iGPU on i915, backlight $(cat $BL/brightness), GDM started"
  else
    log "WARN: iGPU driver is '$(drv)', not i915. Reboot the laptop to get the display back."
  fi
}

to_host() {
  if [ "$(state $VM)" = running ]; then
    log "shutting down $VM"
    # macOS answers the ACPI power button only with a dialog, and a real Shut Down hangs at the
    # end anyway (see watchdog): give it 30 s, then force off. Save work in macOS before switching.
    virsh shutdown "$VM" >/dev/null
    for i in $(seq 1 6); do [ "$(state $VM)" = "shut off" ] && break; sleep 5; done
    [ "$(state $VM)" = "shut off" ] || { log "forcing off"; virsh destroy "$VM" >/dev/null; }
  fi
  to_host_hw
}

RADIOS=off; DISK=overlay; HDMI_RESTART=0; HDMI_STOP_WIN=0
for a in "${@:2}"; do
  case "$a" in
    --radios) RADIOS=on ;; --wifi) RADIOS=wifi ;; --overlay) DISK=overlay ;; --nvme) DISK=nvme ;;
    --restart) HDMI_RESTART=1 ;; --stop-win) HDMI_STOP_WIN=1 ;;
    *) echo "unknown option $a"; exit 2 ;;
  esac
done
case "${1:-status}" in
  mac) to_mac; status ;;
  host) to_host; status ;;
  win) to_win; status ;;
  win-off) to_win_off; status ;;
  hdmi-on) to_hdmi_on; status ;;
  hdmi-off) to_hdmi_off; status ;;
  status) status ;;
  net-backup) net_backup ;;
  new-overlay)
    [ "$(state $VM)" = "shut off" ] && [ "$(state macos)" = "shut off" ] || die "shut down the macOS VMs first"
    new_overlay ;;
  *) echo "usage: gpu-mode mac|mac-bg|host|win|win-off|hdmi-on|hdmi-on-bg|hdmi-off|hdmi-off-bg|status|new-overlay|net-backup"; exit 2 ;;
esac
