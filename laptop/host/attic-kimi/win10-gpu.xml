<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>win10-gpu</name>
  <uuid>77c1f6e2-3b2a-4c4e-9a1f-2d8b6a5c9d02</uuid>
  <memory unit='GiB'>16</memory>
  <currentMemory unit='GiB'>16</currentMemory>
  <vcpu placement="static">8</vcpu>
  <cputune><shares>10000</shares></cputune>
  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
    <loader readonly='yes' type='pflash'>/usr/share/edk2/x64/OVMF_CODE.4m.fd</loader>
    <nvram template='/usr/share/edk2/x64/OVMF_VARS.4m.fd'>/var/lib/libvirt/qemu/nvram/win10-gpu_VARS.fd</nvram>
  </os>
  <features>
    <acpi/><apic/>
    <!-- NVIDIA Error 43 fix: hide KVM, spoof hypervisor vendor -->
    <kvm><hidden state='on'/></kvm>
    <hyperv mode='custom'>
      <relaxed state='on'/><vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
      <vendor_id state='on' value='GenuineIntel'/>
    </hyperv>
    <vmport state='off'/><ioapic driver='kvm'/>
  </features>
  <cpu mode='host-passthrough' check='none' migratable='off'>
    <topology sockets="1" dies="1" cores="4" threads="2"/>
    <cache mode="passthrough"/>
  </cpu>
  <clock offset='localtime'><timer name='rtc' tickpolicy='catchup'/><timer name='pit' tickpolicy='delay'/><timer name='hpet' present='yes'/></clock>
  <on_poweroff>destroy</on_poweroff><on_reboot>restart</on_reboot><on_crash>destroy</on_crash>
  <devices>
    <serial type='file'><source path='/var/lib/libvirt/qemu/win10-gpu-serial.log'/><target type='isa-serial' port='0'/></serial>
    <!-- Windows system disk (virtio; load the storage driver from the second CD during install) -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='none'/>
      <source file='/var/lib/libvirt/images/win10-gpu/win10-lt.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <!-- virtio-win driver ISO (download virtio-win.iso from fedorapeople into this path) -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/images/win10-gpu/virtio-win.iso'/>
      <target dev='sda' bus='sata'/>
    </disk>
    <interface type='network'>
      <mac address='52:54:00:aa:bb:62'/>
      <source network='default'/>
      <model type='virtio'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x04' function='0x0'/>
    </interface>
    <!-- GTX 1650 Mobile (01:00.0 VGA + 01:00.1 HDMI audio), bound to vfio-pci on the host.
         Its display output is the laptop's external HDMI port. -->
    <controller type='pci' index='1' model='pcie-root-port'>
      <model name='pcie-root-port'/>
      <target chassis='1' port='0x10'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x03' function='0x0'/>
    </controller>
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source><address domain='0x0000' bus='0x01' slot='0x00' function='0x0'/></source>
      <address type='pci' domain='0x0000' bus='0x01' slot='0x00' function='0x0' multifunction='on'/>
    </hostdev>
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source><address domain='0x0000' bus='0x01' slot='0x00' function='0x1'/></source>
      <address type='pci' domain='0x0000' bus='0x01' slot='0x00' function='0x1'/>
    </hostdev>
    <controller type='usb' model='qemu-xhci'/>
    <input type='tablet' bus='usb'/>
    <input type='keyboard' bus='usb'/>
    <graphics type='vnc' port='5903' autoport='no' listen='127.0.0.1' passwd='CHANGE_ME'><listen type='address' address='127.0.0.1'/></graphics>
    <!-- Console fallback for install; once the NVIDIA driver binds, the real screen is the HDMI output -->
    <video><model type='vga' vram='16384'/></video>
    <memballoon model='none'/>
  </devices>
</domain>
