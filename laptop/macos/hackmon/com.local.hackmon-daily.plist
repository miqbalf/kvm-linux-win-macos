<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.local.hackmon-daily</string>
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>-c</string>
        <string>/usr/local/bin/hackmon daily</string></array>
    <key>StartCalendarInterval</key><dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
    <key>LowPriorityIO</key><true/>
    <key>Nice</key><integer>10</integer>
    <key>StandardOutPath</key><string>/Library/Logs/HackMon/daemon.log</string>
    <key>StandardErrorPath</key><string>/Library/Logs/HackMon/daemon.log</string>
</dict>
</plist>
