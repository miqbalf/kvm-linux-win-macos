<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.local.apfs-trim-cycle</string>
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>-c</string>
        <string>sleep 60; /usr/local/sbin/apfs-trim-cycle boot; /usr/local/sbin/apfs-trim-cycle check</string></array>
    <key>RunAtLoad</key><true/>
    <key>StartCalendarInterval</key><dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key><string>/var/log/apfs-trim-cycle.log</string>
    <key>StandardErrorPath</key><string>/var/log/apfs-trim-cycle.log</string>
</dict>
</plist>
