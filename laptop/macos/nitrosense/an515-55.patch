diff --git a/Kext/NitroEC.hpp b/Kext/NitroEC.hpp
index a920696..6db5aa4 100644
--- a/Kext/NitroEC.hpp
+++ b/Kext/NitroEC.hpp
@@ -4,14 +4,20 @@
 #include <IOKit/IOService.h>
 #include <IOKit/IOUserClient.h>
 #include <IOKit/IOLocks.h>
+#include <IOKit/IOMemoryDescriptor.h>
 #include <IOKit/acpi/IOACPIPlatformDevice.h>
 
-// Matches \_SB.NTRO (_HID "NTRO0001") from SSDT-NITRO and exposes EC RAM reads.
+// AN515-55 port: matches the firmware WMI device \_SB.PCI0.WMID (PNP0C14, _UID "APGe")
+// directly, so no SSDT is needed. EC RAM reads come from the firmware's own
+// SystemMemory mirror (ECBase, 0xFC7E0800 on AN515-55), mapped read-only.
 class NitroEC : public IOService {
     OSDeclareDefaultStructors(NitroEC)
 
     IOACPIPlatformDevice *acpi {nullptr};
     IOLock *lock {nullptr};
+    IOMemoryMap *ecMap {nullptr};
+    volatile const uint8_t *ecRAM {nullptr};
+    bool hasWMBE {false};
 
 public:
     bool start(IOService *provider) override;
