diff --git a/Core/NitroCore.swift b/Core/NitroCore.swift
index a9b9255..518858b 100644
--- a/Core/NitroCore.swift
+++ b/Core/NitroCore.swift
@@ -238,6 +238,8 @@ enum FanUnit: CaseIterable {
 }
 
 func setPSEE(_ ec: NitroEC, _ on: Bool) throws {
+    // AN515-55: no raw EC writes; the firmware WMBH calls do not need PSEE.
+    return
     let current = Int(try ec.readByte(UInt8(Reg.battery)))
     let wanted = on ? current | 0x10 : current & ~0x10
     if wanted != current {
@@ -261,25 +263,24 @@ func setFan(_ ec: NitroEC, _ units: [FanUnit], mode: String, percent: Int?, viaW
         }
     }
 
-    try setPSEE(ec, true)
+    // AN515-55: fan behavior via firmware WMBH 0x0E [mask, 0, mode bits], then
+    // manual duty via WMBH 0x10 [group, percent] (Linuwu-Sense sequence).
+    let modeBits: UInt8
+    switch mode {
+    case "auto": modeBits = 1
+    case "max": modeBits = 2
+    case "manual": modeBits = 3
+    default: throw NitroECError(description: "fan mode must be auto, max or manual")
+    }
+    var mask: UInt8 = 0, bits: UInt8 = 0
     for unit in units {
-        switch mode {
-        case "auto":
-            try ec.writeByte(unit.modeReg, unit.auto)
-        case "max":
-            try ec.writeByte(unit.modeReg, unit.max)
-        case "manual":
-            if viaWMI {
-                let result = try ec.wmbh(0x10, [unit.wmbhGroup, UInt8(percent!)])
-                guard result.first == 0 else {
-                    throw NitroECError(description: "firmware WMBH 0x10 returned status \(result.first ?? 0xFF)")
-                }
-            } else {
-                try ec.writeByte(unit.speedReg, percent!)
-            }
-            try ec.writeByte(unit.modeReg, unit.manual)
-        default:
-            throw NitroECError(description: "fan mode must be auto, max or manual")
+        mask |= unit == .cpu ? 0x01 : 0x08
+        bits |= unit == .cpu ? modeBits : modeBits << 6
+    }
+    try checkWMBH(try ec.wmbh(0x0E, [mask, 0, bits]), "fan \(mode)")
+    if mode == "manual" {
+        for unit in units {
+            try checkWMBH(try ec.wmbh(0x10, [unit.wmbhGroup, UInt8(percent!)]), "fan speed")
         }
     }
 }
@@ -395,3 +396,12 @@ func applyLED(_ ec: NitroEC, _ led: LEDState) throws {
     try checkWMBH(try ec.wmbh(0x14, bytes), "LED effect")
 }
 
+
+// AN515-55 (Linuwu-Sense an515_58_rgb_fix): after per-zone colours, WMBH 0x14 with
+// only brightness (byte 2) and byte 9 = 1 makes the zones visible.
+func applyStaticAfterZones(_ ec: NitroEC, brightness: UInt8) throws {
+    var bytes = [UInt8](repeating: 0, count: 16)
+    bytes[2] = brightness
+    bytes[9] = 1
+    try checkWMBH(try ec.wmbh(0x14, bytes), "static mode after zones")
+}
