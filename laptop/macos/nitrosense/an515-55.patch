diff --git a/Scripts/install-an515-55.command b/Scripts/install-an515-55.command
new file mode 100755
index 0000000..e67fcb0
--- /dev/null
+++ b/Scripts/install-an515-55.command
@@ -0,0 +1,61 @@
+#!/bin/bash
+# NitroSense for Acer Nitro 5 AN515-55 (macOS Hackintosh). Double-click to install.
+# Installs: NitroEC.kext (/Library/Extensions), nitrod daemon, nitroctl, NitroSense.app.
+# No SSDT and no OpenCore change needed on the AN515-55.
+set -euo pipefail
+HERE="$(cd "$(dirname "$0")" && pwd)"
+P="$HERE/.payload"
+echo "NitroSense AN515-55 installer. Your password is needed (sudo)."
+sudo -v
+
+# 1. kext
+sudo rm -rf /Library/Extensions/NitroEC.kext
+sudo cp -R "$P/NitroEC.kext" /Library/Extensions/
+sudo chown -R root:wheel /Library/Extensions/NitroEC.kext
+if sudo kmutil load -p /Library/Extensions/NitroEC.kext; then
+    KEXT_OK=1
+else
+    KEXT_OK=0
+fi
+
+# 2. daemon + CLI
+DEST="/Library/Application Support/NitroSense"
+LABEL="com.nitrosense.nitrod"
+PLIST="/Library/LaunchDaemons/$LABEL.plist"
+sudo launchctl bootout "system/$LABEL" 2>/dev/null || true
+sudo mkdir -p "$DEST"
+sudo install -o root -g wheel -m 755 "$P/nitrod" "$DEST/nitrod"
+sudo install -o root -g wheel -m 755 "$P/nitroctl" "$DEST/nitroctl"
+sudo mkdir -p /usr/local/bin
+sudo ln -sf "$DEST/nitroctl" /usr/local/bin/nitroctl
+sudo tee "$PLIST" >/dev/null <<PL
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+    <key>Label</key><string>$LABEL</string>
+    <key>ProgramArguments</key><array><string>$DEST/nitrod</string></array>
+    <key>RunAtLoad</key><true/>
+    <key>KeepAlive</key><true/>
+    <key>ThrottleInterval</key><integer>10</integer>
+    <key>StandardErrorPath</key><string>/var/log/nitrod.log</string>
+</dict>
+</plist>
+PL
+sudo chown root:wheel "$PLIST"; sudo chmod 644 "$PLIST"
+sudo launchctl bootstrap system "$PLIST" || true
+
+# 3. app
+pkill -x NitroSense 2>/dev/null || true
+sudo rm -rf /Applications/NitroSense.app
+sudo ditto "$HERE/NitroSense.app" /Applications/NitroSense.app
+sudo chown -R "$(id -un)":staff /Applications/NitroSense.app
+open /Applications/NitroSense.app || true
+
+echo
+if [ "$KEXT_OK" = 1 ]; then
+    echo "Done. NitroSense is in the menu bar."
+else
+    echo "Done. macOS must allow the kext: System Settings > Privacy & Security > Allow, then restart."
+fi
+read -r -p "Press Enter to close."
diff --git a/Scripts/make-dmg-an515-55.sh b/Scripts/make-dmg-an515-55.sh
new file mode 100755
index 0000000..3a69aae
--- /dev/null
+++ b/Scripts/make-dmg-an515-55.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+# Build everything (no SSDT) and pack NitroSense-AN515-55-<version>.dmg.
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+VERSION="${VERSION:-1.1.0-an515-55}"
+cd "$ROOT"
+make kext cli daemon
+# The app needs Xcode (SwiftUI macros); CLT alone cannot build it. Build it with Xcode first if missing.
+[ -d build/NitroSense.app ] || make app
+STAGE="$(mktemp -d)/NitroSense"
+mkdir -p "$STAGE/.payload"
+ditto build/NitroSense.app "$STAGE/NitroSense.app"
+ditto build/NitroEC.kext "$STAGE/.payload/NitroEC.kext"
+cp build/nitrod build/nitroctl "$STAGE/.payload/"
+cp Scripts/install-an515-55.command "$STAGE/Install NitroSense.command"
+cp Scripts/uninstall-an515-55.command "$STAGE/Uninstall NitroSense.command"
+chmod +x "$STAGE"/*.command
+cat > "$STAGE/README.txt" <<TXT
+NitroSense for Acer Nitro 5 AN515-55 (macOS Hackintosh), $VERSION
+
+1. Double-click "Install NitroSense.command" (asks for your password).
+2. First time only: allow the kext in System Settings > Privacy & Security, then restart.
+3. NitroSense sits in the menu bar: fans (Auto / Max / Manual / Curve) and keyboard RGB.
+   Terminal: nitroctl status, sudo nitroctl fan all max, sudo nitroctl led zone all 00FF00
+
+Needs SIP that allows unsigned kexts. Based on NitroSense-macOS (GPL-3.0).
+TXT
+OUT="$ROOT/dist/NitroSense-AN515-55-$VERSION.dmg"
+mkdir -p "$ROOT/dist"; rm -f "$OUT"
+hdiutil create -volname "NitroSense AN515-55" -srcfolder "$STAGE" -fs HFS+ -format UDZO "$OUT" >/dev/null
+echo "$OUT"
diff --git a/Scripts/uninstall-an515-55.command b/Scripts/uninstall-an515-55.command
new file mode 100755
index 0000000..1f8eb0d
--- /dev/null
+++ b/Scripts/uninstall-an515-55.command
@@ -0,0 +1,13 @@
+#!/bin/bash
+# Remove NitroSense (AN515-55): app, daemon (fans back to Auto), CLI, kext.
+set -uo pipefail
+sudo -v
+pkill -x NitroSense 2>/dev/null
+sudo launchctl bootout system/com.nitrosense.nitrod 2>/dev/null
+sudo rm -f /Library/LaunchDaemons/com.nitrosense.nitrod.plist /usr/local/bin/nitroctl
+sudo rm -rf "/Library/Application Support/NitroSense" /Applications/NitroSense.app
+sudo kmutil unload -b com.nitrosense.NitroEC 2>/dev/null
+sudo rm -rf /Library/Extensions/NitroEC.kext
+sudo kmutil clear-staging 2>/dev/null
+echo "Removed. Restart to drop the kext from the kernel cache."
+read -r -p "Press Enter to close."
