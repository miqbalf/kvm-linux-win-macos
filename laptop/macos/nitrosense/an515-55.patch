diff --git a/Kext/NitroEC.cpp b/Kext/NitroEC.cpp
index a163aa7..0dad3f7 100644
--- a/Kext/NitroEC.cpp
+++ b/Kext/NitroEC.cpp
@@ -36,6 +36,7 @@ enum : uint32_t {
     kWMBHGetSensor   = 0x05,  // also sets PSEE
     kWMBHSetZoneRGB  = 0x06,
     kWMBHGetZoneRGB  = 0x07,
+    kWMBHSetFanMode  = 0x0E,  // AN515-55 fan behavior: [mask (1 CPU, 8 GPU), 0, mode bits]
     kWMBHSetFanSpeed = 0x10,
     kWMBHGetFanSpeed = 0x11,
     kWMBHGetFanTable = 0x13,
@@ -94,8 +95,23 @@ bool NitroEC::isWMBHAllowed(uint32_t opcode, const uint8_t *in) {
     case kWMBHSetZoneRGB:
     case kWMBHGetZoneRGB:
         return isZoneMask(in[0]);
+    case kWMBHSetFanMode: {
+        // Byte 2: CPU mode in bits 0-1, GPU mode in bits 6-7 (1 auto, 2 max, 3 manual),
+        // as Linuwu-Sense sends it on AN515-55. Only fields named in the mask may be set.
+        uint8_t mask = in[0], mode = in[2];
+        if ((mask != 0x01 && mask != 0x08 && mask != 0x09) || in[1] || !isZeroFrom(in, 3))
+            return false;
+        uint8_t cpu = mode & 0x03, gpu = (mode >> 6) & 0x03;
+        if (mode & 0x3C)
+            return false;
+        if (mask & 0x01 ? cpu == 0 : cpu != 0)
+            return false;
+        if (mask & 0x08 ? gpu == 0 : gpu != 0)
+            return false;
+        return true;
+    }
     case kWMBHSetFanSpeed:
-        return isFanGroup(in[0]) && in[1] >= kFanSpeedMin && in[1] <= kFanSpeedMax;
+        return isFanGroup(in[0]) && in[1] >= kFanSpeedMin && in[1] <= kFanSpeedMax && isZeroFrom(in, 2);
     case kWMBHGetFanSpeed:
         return isFanGroup(in[0]);
     case kWMBHGetFanTable:
@@ -132,31 +148,67 @@ bool NitroEC::start(IOService *provider) {
         return false;
     }
 
-    UInt32 version = 0;
-    if (acpi->evaluateInteger("VERS", &version) != kIOReturnSuccess || version != kNitroECACPIVersion) {
-        LOG("SSDT-NITRO missing or wrong version (got %u, want %u)", version, kNitroECACPIVersion);
+    // The gaming WMI method must exist on this WMI device.
+    if (acpi->validateObject("WMBH") != kIOReturnSuccess) {
+        LOG("WMBH not found on %s, not an Acer gaming WMI device", provider->getName());
+        return false;
+    }
+    hasWMBE = acpi->validateObject("WMBE") == kIOReturnSuccess;
+
+    OSNumber *base = OSDynamicCast(OSNumber, getProperty("ECBase"));
+    if (!base) {
+        LOG("ECBase missing from personality");
+        return false;
+    }
+
+    // Physical address: firmware EC RAM mirror. (withAddressRange + kernel_task would
+    // treat it as a kernel virtual address and page-fault on first read.)
+    IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(
+        static_cast<IOPhysicalAddress>(base->unsigned64BitValue()), kNitroECDumpSize, kIODirectionIn);
+    if (!md)
+        return false;
+    ecMap = md->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapInhibitCache | kIOMapReadOnly);
+    md->release();
+    if (!ecMap) {
+        LOG("cannot map EC window 0x%llx", base->unsigned64BitValue());
+        return false;
+    }
+    ecRAM = reinterpret_cast<volatile const uint8_t *>(ecMap->getVirtualAddress());
+    if (!ecRAM || ecMap->getPhysicalAddress() != base->unsigned64BitValue()) {
+        LOG("EC window mapped wrong (va %p, pa 0x%llx)", ecRAM, ecMap->getPhysicalAddress());
+        ecRAM = nullptr;
+        OSSafeReleaseNULL(ecMap);
         return false;
     }
 
     lock = IOLockAlloc();
-    if (!lock)
+    if (!lock) {
+        OSSafeReleaseNULL(ecMap);
         return false;
+    }
 
     acpi->retain();
 
-    uint8_t cpuTemp = 0;
-    if (readByte(0xB0, &cpuTemp) == kIOReturnSuccess)
-        LOG("started, SSDT v%u, CPU temp %u C", version, cpuTemp);
+    LOG("started on %s, EC 0x%llx, CPU %u C, CPU fan %u rpm, WMBE %s", provider->getName(),
+        base->unsigned64BitValue(), ecRAM[0xB0], ecRAM[0x13] | (ecRAM[0x14] << 8), hasWMBE ? "yes" : "no");
 
-    setProperty("NitroEC SSDT Version", version, 32);
+    setProperty("NitroEC SSDT Version", kNitroECACPIVersion, 32);
+    setProperty("NitroEC Model", "AN515-55");
     registerService();
     return true;
 }
 
 void NitroEC::stop(IOService *provider) {
-    // Never leave the fans in manual mode without a driver behind them.
-    writeByte(kRegCPUFanMode, kCPUFanAuto);
-    writeByte(kRegGPUFanMode, kGPUFanAuto);
+    // Never leave the fans in manual mode without a driver behind them:
+    // WMBH 0x0E fan behavior, CPU+GPU auto.
+    if (acpi) {
+        uint8_t in[kNitroECWMBHInSize] = {0x09, 0x00, 0x41};
+        uint8_t out[kNitroECWMBHOutSize];
+        uint32_t outLength = sizeof(out);
+        callWMI("WMBH", 0x0E, in, out, &outLength);
+    }
+    OSSafeReleaseNULL(ecMap);
+    ecRAM = nullptr;
     OSSafeReleaseNULL(acpi);
     IOService::stop(provider);
 }
