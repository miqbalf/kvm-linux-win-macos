+func setFanMode(_ ec: NitroEC, _ unit: FanUnit, _ mode: UInt8) throws {
+    let mask: UInt8 = unit == .cpu ? 0x01 : 0x08
+    let bits: UInt8 = unit == .cpu ? mode : mode << 6
+    try checkWMBH(try ec.wmbh(0x0E, [mask, 0, bits]), "fan mode")
