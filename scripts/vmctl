#!/bin/bash
# vmctl: start/stop/status/ip/console for libvirt VMs on the host. Run ON the host (or: ssh <host> vmctl ...).
# No autostart by design: VMs only run when you start them.
set -u
VM="${2:-macos}"
case "${1:-}" in
  start)
    # GPU 1 cannot be reset between different OSes on this hardware (Navi 22, no vendor reset). A guest that used the
    # GPU leaves it in a state the other OS may not initialise (macOS panics in AMDRadeonX6000 powerUp after Windows).
    # /run is cleared on reboot, so the marker means "GPU 1 was used by this guest since boot".
    case "$VM" in macos|win10-gpu)
      M=/run/gpu1-last-guest
      # Only Windows -> macOS is known to fail (macOS panics in AMDRadeonX6000 powerUp). macOS -> Windows booted fine.
      if [ "$VM" = macos ] && [ -f "$M" ] && [ "$(cat $M)" = win10-gpu ] && [ "${FORCE:-0}" != 1 ]; then
        echo "GPU 1 was last used by win10-gpu. Reboot the host first (systemctl reboot) or run FORCE=1 vmctl start macos"; exit 2
      fi
      echo "$VM" > "$M" ;;
    esac
    # Start, then wait until macOS answers on the network (ping + SSH banner). Retry up to 3 times if it does not.
    # (Early boot panics were fixed by removing serial=3 from OpenCore boot-args; the retry stays as a safety net.)
    MAC=$(virsh domiflist "$VM" | awk 'NR>2{print $5; exit}')
    IP=$(virsh net-dumpxml default | grep -i "mac='$MAC'" | sed -n "s/.*ip='\\([^']*\\)'.*/\\1/p")
    for try in 1 2 3; do
      virsh destroy "$VM" >/dev/null 2>&1; sleep 5
      virsh start "$VM" || exit 1
      [ "$VM" = macos ] || { echo "$VM started"; exit 0; }
      for i in $(seq 1 18); do sleep 5
        ping -c1 -W1 "$IP" >/dev/null 2>&1 && echo | nc -w2 "$IP" 22 2>/dev/null | grep -q SSH-2.0 && { echo "$VM up after $((i*5))s (try $try)"; exit 0; }
      done
      echo "$VM not reachable after 90s on try $try, restarting"
    done
    echo "FAILED: $VM not reachable after 3 tries"; exit 1 ;;
  stop)    virsh shutdown "$VM"; echo "macOS ignores ACPI shutdown until you click Shut Down in the guest; use 'force-stop' if needed" ;;
  force-stop) virsh destroy "$VM" ;;
  restart) virsh destroy "$VM" 2>/dev/null; sleep 3; virsh start "$VM" ;;
  status)  virsh list --all; virsh domifaddr "$VM" 2>/dev/null ;;
  ip)      virsh domifaddr "$VM" --source lease 2>/dev/null | awk '/ipv4/{print $4}' ;;
  console) echo "VNC console: 127.0.0.1 on the host; tunnel with: ssh -L 5902:127.0.0.1:5902 <host-tailscale-name>" ;;
  *) echo "usage: vmctl {start|stop|force-stop|restart|status|ip|console} [vm-name]"; exit 1 ;;
esac
