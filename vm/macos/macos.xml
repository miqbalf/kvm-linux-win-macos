    <disk type="file" device="disk"><driver name="qemu" type="qcow2" cache='none'/><source file="/mnt/SSD_DATA/macos-vm/sda-overlay.qcow2"/><backingStore type="block"><format type="raw"/><source dev="/dev/sda"/></backingStore><target dev="sdb" bus="sata"/></disk>
    
    <interface type='network'>
      <mac address='52:54:00:aa:bb:51'/>
      <source network='default'/>
      <model type='vmxnet3'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x04' function='0x0'/>
    </interface>
    <controller type='usb' model='qemu-xhci'/>
    <input type='tablet' bus='usb'/>
    <input type='keyboard' bus='usb'/>
    <graphics type='vnc' port='5902' autoport='no' listen='127.0.0.1' passwd='CHANGE_ME'><listen type='address' address='127.0.0.1'/></graphics>
    <controller type='pci' index='1' model='pcie-root-port'>
