<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>macos</name>
  <uuid>44f776ae-d280-44b9-9b4e-78ffa9234736</uuid>
  <memory unit='GiB'>16</memory>
  <currentMemory unit='GiB'>16</currentMemory>
  <vcpu placement="static">12</vcpu>
  <cputune><shares>10000</shares></cputune>
  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
    <loader readonly='yes' type='pflash'>/usr/share/OVMF/OVMF_CODE_4M.fd</loader>
    <nvram template='/usr/share/OVMF/OVMF_VARS_4M.fd'>/var/lib/libvirt/qemu/nvram/macos_VARS.fd</nvram>
  </os>
  <features><acpi/><apic/><kvm><hidden state='on'/></kvm><vmport state='off'/><ioapic driver='kvm'/></features>
