# /etc/samba/smb.conf: one authenticated, encrypted share, reachable only from the VM network (virbr0) and, through
# smb-tailscale.service, from Tailscale. Samba skips point-to-point interfaces such as tailscale0, hence the forwarder.
[global]
   server role = standalone server
   workgroup = WORKGROUP
   server string = Host share
   interfaces = lo virbr0
   bind interfaces only = yes
   disable netbios = yes
   smb ports = 445
   map to guest = never
   restrict anonymous = 2
   server min protocol = SMB3
   smb encrypt = desired
   load printers = no
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 1000

[DATA_HDD]
   comment = Internal HDD
   path = /mnt/DATA_HDD
   valid users = vmshare
   read only = no
   browseable = yes
   create mask = 0660
   directory mask = 0770
   veto files = /$RECYCLE.BIN/System Volume Information/
