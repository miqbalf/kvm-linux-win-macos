[Unit]
Description=Forward Tailscale :445 to local Samba (Samba skips point-to-point interfaces)
After=network-online.target tailscaled.service smbd.service

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:445,bind=${TAILSCALE_IP},reuseaddr,fork TCP:127.0.0.1:445
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
