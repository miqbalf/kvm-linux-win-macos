[Unit]
Description=Forward Tailscale :3389 to Windows VM RDP
After=network-online.target tailscaled.service libvirtd.service
Wants=tailscaled.service

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:3389,bind=${TAILSCALE_IP},reuseaddr,fork TCP:192.168.122.11:3389
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
